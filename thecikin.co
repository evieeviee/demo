
<!DOCTYPE html>
<html lang="en-MY">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CIKIN.CO | Event Drinks & Refreshments</title>
<meta name="description" content="CIKIN.CO brings crafted event drinks, custom refreshments and neat beverage setups to weddings, hi-teas, private events, booths and celebrations in Malaysia.">
<meta name="theme-color" content="#eee6f5">
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
:root{--ink:#24150f;--brown:#3a2118;--cream:#f7f2ea;--sand:#dfc49d;--gold:#cda469;--muted:#766b64;--white:#fff;--wa:#25D366;--line:rgba(36,21,15,.13)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--cream);line-height:1.65;-webkit-font-smoothing:antialiased}img{display:block;width:100%;height:auto}a{text-decoration:none;color:inherit}.wrap{width:min(1160px,calc(100% - 40px));margin:auto}.eyebrow{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:#9a7449}.serif{font-family:'Playfair Display',serif}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:0 22px;border-radius:999px;font-weight:700;font-size:.9rem;transition:.25s ease;border:1px solid transparent}.btn-dark{background:var(--ink);color:white}.btn-dark:hover{transform:translateY(-2px);background:#3c241a}.btn-light{background:white;color:var(--ink)}.btn-light:hover{transform:translateY(-2px)}
.hero{background:var(--ink);color:white;min-height:86vh;display:flex;align-items:center;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;right:-12%;bottom:-30%;width:520px;height:520px;border-radius:50%;background:rgba(205,164,105,.09)}.hero-inner{display:grid;grid-template-columns:.92fr 1.08fr;gap:58px;align-items:center;padding:52px 0;position:relative;z-index:1}.hero-copy{padding-top:8px}.hero-logo{width:min(370px,76%);filter:brightness(0) invert(1);margin-bottom:54px}.hero h1{font-family:'Playfair Display',serif;font-size:clamp(2.7rem,5.4vw,4.8rem);line-height:1.03;letter-spacing:-.035em;margin:0 0 22px;font-weight:600}.hero h1 em{color:var(--sand);font-weight:600}.hero p{max-width:570px;color:rgba(255,255,255,.72);font-size:1rem;margin:0 0 30px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero-photo{position:relative}.hero-photo img{height:min(70vh,690px);object-fit:cover;border-radius:26px}.hero-tag{position:absolute;left:-28px;bottom:28px;background:var(--sand);color:var(--ink);padding:14px 18px;border-radius:14px;font-size:.78rem;font-weight:700;box-shadow:0 16px 40px rgba(0,0,0,.22)}
section{padding:92px 0}.intro-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:72px;align-items:start}.intro-grid h2,.section-title{font-family:'Playfair Display',serif;font-size:clamp(2.15rem,4vw,3.45rem);line-height:1.08;letter-spacing:-.025em;margin:10px 0 0}.intro-copy{font-size:1rem;color:var(--muted)}.intro-copy p{margin:0 0 18px}.heritage{margin-top:30px;padding-top:24px;border-top:1px solid var(--line);display:flex;gap:28px;flex-wrap:wrap}.heritage b{display:block;font-family:'Playfair Display',serif;font-size:1.55rem;color:var(--ink)}.heritage span{font-size:.78rem;color:var(--muted)}
.services{background:white}.service-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:20px;margin-top:38px}.service-main,.service-side{border-radius:24px;padding:34px;min-height:260px;display:flex;flex-direction:column;justify-content:flex-end}.service-main{background:linear-gradient(180deg,rgba(36,21,15,.05),rgba(36,21,15,.88)),url('data:image/webp;base64,') center/cover;color:white}.service-side{background:#efe5d6}.service-kicker{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;margin-bottom:10px;opacity:.8}.service-main h3,.service-side h3{font-family:'Playfair Display',serif;font-size:2rem;margin:0 0 10px;line-height:1.1}.service-main p{color:rgba(255,255,255,.78);max-width:620px;margin:0}.service-side p{color:#66584f;margin:0}.service-link{margin-top:20px;font-weight:700;font-size:.86rem;display:inline-flex;align-items:center;gap:8px}
.menu{background:var(--brown);color:white}.menu-head{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:42px}.menu-head p{max-width:460px;color:rgba(255,255,255,.66);margin:0}.menu-layout{display:grid;grid-template-columns:.95fr 1.05fr;gap:30px;align-items:stretch}.menu-photo{border-radius:24px;overflow:hidden;min-height:560px;position:relative}.menu-photo img{height:100%;object-fit:cover}.menu-photo:after{content:"Actual CIKIN.CO drinks";position:absolute;left:18px;bottom:18px;background:rgba(36,21,15,.84);color:white;padding:10px 14px;border-radius:999px;font-size:.7rem;font-weight:700;letter-spacing:.06em}.menu-list{display:grid;grid-template-columns:1fr 1fr;gap:14px}.menu-group{padding:24px;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.035)}.menu-group h3{font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sand);margin:0 0 14px}.menu-group ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}.menu-group li{font-family:'Playfair Display',serif;font-size:1.05rem}.custom-note{grid-column:1/-1;padding:20px 22px;background:var(--sand);color:var(--ink);border-radius:18px;display:flex;justify-content:space-between;gap:20px;align-items:center}.custom-note strong{font-family:'Playfair Display',serif;font-size:1.15rem}.custom-note span{font-size:.82rem;color:#6f5033}
.packages{background:var(--cream)}.package-head{text-align:center;max-width:680px;margin:auto}.package-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:38px}.package{background:white;border:1px solid var(--line);border-radius:20px;padding:26px 22px;transition:.25s ease;cursor:pointer}.package:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(36,21,15,.08)}.package small{display:block;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.13em}.package strong{display:block;font-family:'Playfair Display',serif;font-size:1.85rem;margin:6px 0 2px}.package span{font-weight:700;color:#8c6338}.package.selected{outline:2px solid var(--gold);background:#fffaf1}
.refresh{padding-top:0}.refresh-banner{background:var(--ink);color:white;border-radius:28px;padding:42px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}.refresh-banner h3{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3.5vw,2.6rem);margin:0 0 8px}.refresh-banner p{margin:0;color:rgba(255,255,255,.68);max-width:700px}
.gallery{background:white}.gallery-head{text-align:center;max-width:680px;margin:auto}.gallery-grid{margin-top:36px;display:grid;grid-template-columns:1.3fr .85fr .85fr;grid-template-rows:260px 260px;gap:14px}.gallery-grid figure{margin:0;overflow:hidden;border-radius:20px}.gallery-grid figure:first-child{grid-row:1/3}.gallery-grid figure:last-child{grid-column:2/4}.gallery-grid img{height:100%;object-fit:cover;transition:.5s ease}.gallery-grid figure:hover img{transform:scale(1.035)}
.enquiry{background:#efe5d6}.enquiry-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;align-items:start}.enquiry-copy p{color:var(--muted);margin:16px 0 0}.locations{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.locations span{background:white;border-radius:999px;padding:8px 12px;font-size:.75rem;font-weight:700}.form-card{background:white;border-radius:24px;padding:30px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#7b6f67}.field input,.field select,.field textarea{width:100%;border:1px solid #ded4c8;border-radius:12px;background:#fff;padding:13px 14px;font:inherit;color:var(--ink);outline:none;min-height:48px}.field textarea{min-height:96px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(205,164,105,.13)}.wa-submit{width:100%;border:0;background:var(--wa);color:white;border-radius:14px;min-height:52px;margin-top:14px;font-weight:800;font-size:.9rem;cursor:pointer}.wa-submit:hover{filter:brightness(.97)}
footer{background:var(--ink);color:white;padding:34px 0}.footer-row{display:flex;justify-content:space-between;align-items:center;gap:20px}.footer-logo{width:210px;filter:brightness(0) invert(1)}.footer-contact{display:flex;align-items:center;gap:12px}.icon-link{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.18)}.footer-phone{color:rgba(255,255,255,.82);font-weight:600;font-size:.88rem}.floating-wa{position:fixed;right:18px;bottom:18px;width:56px;height:56px;border-radius:50%;background:var(--wa);display:grid;place-items:center;color:white;z-index:20;box-shadow:0 12px 28px rgba(0,0,0,.2)}.floating-wa svg{width:25px;height:25px;fill:currentColor}.reveal{opacity:0;transform:translateY(18px);transition:.65s ease}.reveal.show{opacity:1;transform:none}
@media(max-width:900px){.hero{min-height:auto}.hero-inner{grid-template-columns:1fr;gap:32px;padding:34px 0 46px}.hero-logo{width:260px;margin-bottom:34px}.hero-photo img{height:520px}.hero-tag{left:16px}.intro-grid,.menu-layout,.enquiry-grid{grid-template-columns:1fr;gap:34px}.service-grid{grid-template-columns:1fr}.package-grid{grid-template-columns:1fr 1fr}.menu-photo{min-height:420px}.gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:280px 220px 220px}.gallery-grid figure:first-child{grid-column:1/3;grid-row:auto}.gallery-grid figure:last-child{grid-column:1/3}.refresh-banner{grid-template-columns:1fr}}
@media(max-width:620px){.wrap{width:min(100% - 28px,1160px)}section{padding:68px 0}.hero-inner{padding-top:26px}.hero-logo{width:230px;margin-bottom:30px}.hero h1{font-size:2.52rem}.hero p{font-size:.94rem}.hero-actions .btn{width:100%}.hero-photo img{height:410px;border-radius:20px}.hero-tag{font-size:.7rem;padding:10px 12px;bottom:12px}.intro-grid h2,.section-title{font-size:2.15rem}.service-main,.service-side{padding:24px;min-height:230px;border-radius:19px}.service-main h3,.service-side h3{font-size:1.65rem}.menu-head{display:block;margin-bottom:28px}.menu-head p{margin-top:14px}.menu-photo{min-height:320px}.menu-list{grid-template-columns:1fr;gap:10px}.menu-group{padding:19px}.menu-group li{font-size:1rem}.custom-note{grid-column:auto;display:block}.custom-note span{display:block;margin-top:6px}.package-grid{grid-template-columns:1fr 1fr;gap:10px}.package{padding:20px 16px}.package strong{font-size:1.5rem}.refresh-banner{padding:28px 22px;border-radius:22px}.gallery-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:230px 190px 190px;gap:10px}.gallery-grid figure:first-child{grid-column:1/3}.gallery-grid figure:last-child{grid-column:1/3}.form-card{padding:22px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.footer-row{flex-direction:column;align-items:flex-start}.footer-logo{width:185px}.floating-wa{width:52px;height:52px}.heritage{gap:18px}.heritage b{font-size:1.35rem}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}.reveal{opacity:1;transform:none}}

/* --- Refined interactive menu showcase --- */
.menu{background:linear-gradient(180deg,#fffaf1 0%,#fbf6ee 100%)}
.menu-head{display:block;max-width:720px;margin:0 auto 30px;text-align:center}
.menu-head p{max-width:620px;margin:12px auto 0;color:var(--muted)}
.menu-showcase{max-width:1000px;margin:0 auto;background:#fff;border:1px solid rgba(95,71,112,.10);border-radius:32px;box-shadow:0 20px 60px rgba(70,48,79,.08);overflow:hidden}
.menu-tabs{display:flex;gap:8px;padding:12px;background:#eee4f4;border-bottom:1px solid rgba(95,71,112,.10);overflow-x:auto;scrollbar-width:none}
.menu-tabs::-webkit-scrollbar{display:none}
.menu-tab{flex:1 0 auto;min-height:44px;padding:0 18px;border:0;border-radius:999px;background:transparent;color:#6c5c73;font-weight:700;font-size:.82rem;letter-spacing:.02em;white-space:nowrap;transition:.25s ease}
.menu-tab:hover{background:rgba(255,255,255,.7)}
.menu-tab.active{background:#765d85;color:#fff;box-shadow:0 7px 18px rgba(118,93,133,.18)}
.menu-display{display:grid;grid-template-columns:.92fr 1.08fr;min-height:430px}
.menu-visual{position:relative;overflow:hidden;background:#e9dded}
.menu-visual img{width:100%;height:100%;min-height:430px;object-fit:cover;transition:opacity .25s ease,transform .45s ease}
.menu-visual::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(49,31,54,.30),transparent 48%);pointer-events:none}
.menu-visual-label{position:absolute;left:18px;bottom:18px;z-index:2;padding:9px 12px;border-radius:999px;background:rgba(255,250,241,.92);color:#67566f;font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;backdrop-filter:blur(6px)}
.menu-panel{padding:42px 42px 38px;display:flex;flex-direction:column;justify-content:center;background:#fffdf9}
.menu-panel-kicker{font-size:.68rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#9778a8;margin-bottom:10px}
.menu-panel h3{font-family:'Playfair Display',serif;font-size:2.15rem;line-height:1.05;color:#55475b;margin:0 0 20px}
.menu-items{list-style:none;margin:0;padding:0;display:grid;gap:0}
.menu-items li{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid #ece4ef;color:#5f5863;font-size:.98rem}
.menu-items li:last-child{border-bottom:0}
.menu-items li::after{content:"";width:7px;height:7px;border-radius:50%;background:#d8c2e2;flex:0 0 auto}
.menu-custom{margin-top:20px;padding:16px 18px;border-radius:16px;background:#f3ebf8;color:#65556d;font-size:.82rem;line-height:1.55}
.menu-custom strong{display:block;color:#55475b;margin-bottom:3px}
.menu-mobile-hint{display:none;margin-top:12px;text-align:center;color:#8b7d90;font-size:.72rem}
@media(max-width:760px){
  .menu-head{text-align:left;margin-bottom:22px}
  .menu-head p{margin-left:0;font-size:.88rem;line-height:1.65}
  .menu-showcase{border-radius:24px}
  .menu-tabs{padding:10px;gap:6px;scroll-snap-type:x proximity}
  .menu-tab{min-height:42px;padding:0 15px;font-size:.78rem;scroll-snap-align:start;flex:0 0 auto}
  .menu-display{grid-template-columns:1fr;min-height:0}
  .menu-visual{height:220px}
  .menu-visual img{min-height:0;height:220px}
  .menu-visual-label{left:12px;bottom:12px;font-size:.61rem;padding:8px 10px}
  .menu-panel{padding:24px 20px 22px;min-height:295px;justify-content:flex-start}
  .menu-panel-kicker{font-size:.62rem;margin-bottom:7px}
  .menu-panel h3{font-size:1.7rem;margin-bottom:12px}
  .menu-items li{padding:11px 0;font-size:.92rem}
  .menu-custom{margin-top:14px;padding:14px;font-size:.78rem}
  .menu-mobile-hint{display:block}
}
@media(max-width:390px){
  .menu-visual,.menu-visual img{height:195px}
  .menu-panel{padding:21px 17px 19px}
  .menu-panel h3{font-size:1.55rem}
  .menu-items li{font-size:.88rem}
}

</style>

<style>
:root{
  --ink:#35283f;
  --brown:#5f4b70;
  --cream:#fffaf0;
  --sand:#ddd0ea;
  --gold:#a98dbd;
  --muted:#756d7d;
  --white:#ffffff;
  --wa:#25D366;
  --line:rgba(78,58,90,.12);
  --lav:#eee6f5;
  --lav2:#d9c8e7;
  --lav3:#bda5d1;
  --ivory:#fffaf0;
  --plum:#5f4770;
  --shadow:0 18px 55px rgba(83,60,97,.10);
}
body{background:var(--ivory);color:var(--ink)}
.wrap{width:min(1120px,calc(100% - 42px))}
.eyebrow{color:#8c6ba1;letter-spacing:.16em}
.btn{border-radius:14px;min-height:48px;padding:0 21px;font-weight:700;box-shadow:none}
.btn-dark{background:var(--plum)}
.btn-dark:hover{background:#493554;transform:translateY(-2px)}
.btn-light{background:rgba(255,255,255,.88);color:var(--plum);border-color:rgba(95,71,112,.13)}
.hero{min-height:78vh;background:linear-gradient(135deg,#efe5f6 0%,#fffaf0 54%,#e5d8ef 100%);color:var(--ink)}
.hero:after{width:430px;height:430px;right:-8%;bottom:-22%;background:rgba(161,124,184,.12)}
.hero:before{content:"";position:absolute;left:-120px;top:-110px;width:330px;height:330px;border-radius:50%;background:rgba(255,255,255,.48)}
.hero-inner{grid-template-columns:1.03fr .97fr;gap:72px;padding:66px 0}
.hero-logo{filter:none;width:min(390px,82%);margin-bottom:44px}
.hero h1{font-size:clamp(2.65rem,5vw,4.5rem);color:#3d2f46}
.hero h1 em{color:#8f6aa6}
.hero p{color:#6f6675;max-width:530px}
.hero-photo{padding:22px 0 12px 22px}
.hero-photo:before{content:"";position:absolute;inset:0 18px 18px 0;border:1px solid rgba(95,71,112,.18);border-radius:34px;transform:rotate(-2deg);z-index:-1}
.hero-photo img{height:min(64vh,620px);border-radius:30px;box-shadow:0 28px 70px rgba(82,59,95,.16)}
.hero-tag{left:auto;right:-12px;bottom:34px;background:rgba(255,250,240,.94);color:var(--plum);border:1px solid rgba(95,71,112,.13);box-shadow:var(--shadow);border-radius:999px;padding:12px 17px}
section{padding:86px 0}
.intro-grid{grid-template-columns:1.02fr .98fr;gap:70px;align-items:center}
.intro-grid h2,.section-title{color:#45364f;font-size:clamp(2.05rem,3.8vw,3.25rem)}
.intro-copy{background:white;padding:30px 32px;border-radius:24px;box-shadow:var(--shadow);border:1px solid var(--line)}
.heritage{border-top:1px solid rgba(95,71,112,.12)}
.services{background:#f2eaf7}
.services .section-title{max-width:650px}
.service-grid{grid-template-columns:1.12fr .88fr;gap:24px}
.service-main,.service-side{border-radius:30px;min-height:300px;padding:34px;overflow:hidden;box-shadow:var(--shadow)}
.service-main{background:linear-gradient(180deg,rgba(55,42,62,.04),rgba(55,42,62,.76)),var(--service-bg,none)}
.service-side{background:linear-gradient(150deg,#fffaf0,#e8dff0);color:#3f3147;border:1px solid rgba(95,71,112,.10)}
.service-side .eyebrow{color:#8d6ba2}
.menu{background:var(--ivory)}
.menu-layout{grid-template-columns:.78fr 1.22fr;gap:34px}
.menu-photo{border-radius:34px;overflow:hidden;box-shadow:var(--shadow);min-height:560px}
.menu-content{background:#f3ebf8;border-radius:34px;padding:34px;border:1px solid rgba(95,71,112,.08)}
.menu-list{gap:12px}
.menu-group{background:rgba(255,255,255,.76);border:1px solid rgba(95,71,112,.10);border-radius:18px;padding:20px 21px}
.menu-group h3{color:#715783}
.menu-group li{color:#5f5863}
.custom-note{background:#ded0e9;border-color:transparent;color:#4c3b58;border-radius:16px}
.packages{background:#ffffff}
.package-head{text-align:center;max-width:660px;margin:0 auto 34px}
.package-grid{gap:14px}
.package{background:linear-gradient(180deg,#fffdf8,#f4edf8);border:1px solid rgba(95,71,112,.10);border-radius:22px;box-shadow:none;padding:26px 20px}
.package:hover,.package.selected{transform:translateY(-4px);box-shadow:0 16px 34px rgba(83,60,97,.12);border-color:#ad93be}
.package strong{color:#614b70}
.refresh{background:#efe6f4}
.refresh-banner{background:linear-gradient(135deg,#6c517e,#8f72a4);border-radius:30px;box-shadow:0 24px 60px rgba(78,58,90,.18)}
.refresh-banner .btn-light{background:#fffaf0}
.gallery{background:#fffaf0}
.gallery-grid{gap:14px}
.gallery-grid figure{border-radius:24px;overflow:hidden;box-shadow:var(--shadow)}
.enquiry{background:linear-gradient(180deg,#f0e8f5 0%,#fffaf0 100%)}
.enquiry-copy{padding-right:20px}
.form-card{border-radius:28px;background:rgba(255,255,255,.9);border:1px solid rgba(95,71,112,.10);box-shadow:var(--shadow)}
.field input,.field select,.field textarea{border:1px solid rgba(95,71,112,.16);border-radius:12px;background:#fffdf9}
.field input:focus,.field select:focus,.field textarea:focus{outline:3px solid rgba(173,147,190,.18);border-color:#a98dbd}
footer{background:#5b456b}
.footer-logo{filter:brightness(0) invert(1)}
.floating-wa{border-radius:18px;box-shadow:0 14px 34px rgba(37,211,102,.28)}
.reveal{transform:translateY(16px);transition:opacity .65s ease,transform .65s ease}
@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:28px;padding:38px 0 46px}
  .hero-copy{text-align:center}.hero-logo{margin:0 auto 30px;width:260px}.hero p{margin-left:auto;margin-right:auto}.hero-actions{justify-content:center}.hero-photo{padding:0;margin-top:8px}.hero-photo img{height:500px}.hero-photo:before{display:none}.hero-tag{right:14px}
  .intro-grid,.menu-layout,.enquiry-grid{grid-template-columns:1fr;gap:30px}
  .intro-copy{padding:26px}.service-grid{grid-template-columns:1fr}.menu-photo{min-height:380px}.menu-content{padding:28px}.gallery-grid{grid-template-columns:1fr 1fr;grid-template-rows:260px 210px 210px}.gallery-grid figure:first-child{grid-column:1/3}.gallery-grid figure:last-child{grid-column:1/3}
}
@media(max-width:620px){
  .wrap{width:min(100% - 28px,1120px)}section{padding:62px 0}.hero{min-height:auto}.hero-inner{padding-top:30px}.hero-logo{width:220px;margin-bottom:24px}.hero h1{font-size:2.34rem;line-height:1.06}.hero p{font-size:.94rem;line-height:1.7}.hero-actions .btn{width:100%}.hero-photo img{height:380px;border-radius:24px}.hero-tag{font-size:.68rem;right:10px;bottom:10px;padding:9px 12px}
  .intro-grid h2,.section-title{font-size:2rem}.intro-copy{padding:22px;border-radius:20px}.service-main,.service-side{min-height:220px;padding:23px;border-radius:22px}.menu-photo{min-height:280px;border-radius:24px}.menu-content{padding:20px;border-radius:24px}.menu-list{grid-template-columns:1fr}.menu-group{padding:18px;border-radius:16px}.menu-group li{font-size:.96rem}.package-grid{grid-template-columns:1fr 1fr;gap:10px}.package{padding:19px 13px;border-radius:18px}.package strong{font-size:1.4rem}.refresh-banner{padding:27px 20px;border-radius:24px}.gallery-grid{grid-template-columns:1fr;grid-template-rows:none}.gallery-grid figure,.gallery-grid figure:first-child,.gallery-grid figure:last-child{grid-column:auto;min-height:220px}.form-card{padding:20px;border-radius:22px}.footer-row{align-items:center;text-align:center}.footer-logo{width:175px}.footer-contact{justify-content:center}.floating-wa{width:52px;height:52px}
}
</style>

</head>
<body>
<header class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy reveal">
      <img class="hero-logo" src="data:image/png;base64," alt="CIKIN.CO Event Drinks">
      <span class="eyebrow" style="color:#dfc49d">Event drinks · Malaysia</span>
      <h1>Beautiful drinks for <em>meaningful moments.</em></h1>
      <p>CIKIN.CO brings crafted beverages and neat mobile drink setups to weddings, hi-teas, private events, booths and celebrations — served where your moment happens.</p>
      <div class="hero-actions">
        <a class="btn btn-light" href="#menu">View Drinks</a>
        <a class="btn btn-dark" style="background:#cda469;color:#24150f" href="#enquire">Plan Your Event</a>
      </div>
    </div>
    <div class="hero-photo reveal">
      <img src="data:image/webp;base64," alt="CIKIN.CO preparing event drinks">
      <div class="hero-tag">Indoor · Outdoor · Mini-space</div>
    </div>
  </div>
</header>

<main>
<section>
  <div class="wrap intro-grid">
    <div class="reveal">
      <span class="eyebrow">Our story</span>
      <h2>From our roots to your moments.</h2>
    </div>
    <div class="intro-copy reveal">
      <p>Our family’s F&amp;B journey began in 1998 with Restoran Asyikin, later rebranded as Mr Lebai. In 2026, CIKIN.CO was created as a new identity focused on bringing that experience beyond the shop and into events.</p>
      <p>Today, we serve celebrations with thoughtfully prepared drinks, flexible setups and a personal touch.</p>
      <div class="heritage">
        <div><b>1998</b><span>Family F&amp;B roots</span></div>
        <div><b>2026</b><span>CIKIN.CO established</span></div>
        <div><b>4 areas</b><span>KL · Selangor · Penang · Kedah</span></div>
      </div>
    </div>
  </div>
</section>

<section class="services">
  <div class="wrap">
    <span class="eyebrow">What we do</span>
    <h2 class="section-title reveal">One brand, two clear services.</h2>
    <div class="service-grid">
      <article class="service-main reveal">
        <div class="service-kicker">Signature service</div>
        <h3>Event Beverage Bar</h3>
        <p>Crafted drinks, mobile beverage setups and refreshment service for weddings, private celebrations, corporate events, booths, hi-teas and more.</p>
        <a class="service-link" href="#enquire">Enquire for drinks →</a>
      </article>
      <article class="service-side reveal">
        <div class="service-kicker">Additional service</div>
        <h3>Cleaning Service</h3>
        <p>Need cleaning support as well? Send us your location, date and requirements for a separate quotation.</p>
        <a class="service-link" href="#enquire">Request cleaning quote →</a>
      </article>
    </div>
  </div>
</section>

<section class="menu" id="menu">
  <div class="wrap">
    <div class="menu-head reveal">
      <span class="eyebrow">Our drinks</span>
      <h2 class="section-title">A menu made easy to explore.</h2>
      <p>Tap a drink category to see the choices. For something different, CIKIN.CO can also discuss refreshment drinks based on your event and budget.</p>
    </div>

    <div class="menu-showcase reveal">
      <div class="menu-tabs" role="tablist" aria-label="Drink categories">
        <button class="menu-tab active" type="button" data-menu="chocolate">Chocolate</button>
        <button class="menu-tab" type="button" data-menu="matcha">Matcha</button>
        <button class="menu-tab" type="button" data-menu="tea">Milk Tea &amp; Tea</button>
        <button class="menu-tab" type="button" data-menu="coffee">Coffee</button>
      </div>

      <div class="menu-display">
        <div class="menu-visual">
          <img id="menuVisual" src="data:image/webp;base64," alt="CIKIN.CO event drink selection">
          <span class="menu-visual-label">CIKIN.CO Event Drinks</span>
        </div>
        <div class="menu-panel">
          <span class="menu-panel-kicker" id="menuKicker">Drink Selection</span>
          <h3 id="menuTitle">Chocolate</h3>
          <ul class="menu-items" id="menuItems">
            <li>Classic Choco</li>
            <li>Choco Berry</li>
            <li>Choco Caramel</li>
            <li>Choco Vanilla</li>
          </ul>
          <div class="menu-custom" id="menuNote"><strong>Need something different?</strong>Custom refreshment drinks can be discussed based on your occasion and budget.</div>
        </div>
      </div>
    </div>
    <div class="menu-mobile-hint">Swipe the category row, then tap to explore.</div>
  </div>
</section>

<section class="packages">
  <div class="wrap">
    <div class="package-head reveal"><span class="eyebrow">Packages</span><h2 class="section-title">Choose what fits your celebration.</h2></div>
    <div class="package-grid">
      <div class="package reveal" data-package="50 cups · RM275"><small>Package A</small><strong>50 cups</strong><span>RM275</span></div>
      <div class="package reveal" data-package="100 cups · RM500"><small>Package B</small><strong>100 cups</strong><span>RM500</span></div>
      <div class="package reveal" data-package="200 cups · RM1000"><small>Package C</small><strong>200 cups</strong><span>RM1,000</span></div>
      <div class="package reveal" data-package="300 cups · RM1500"><small>Package D</small><strong>300 cups</strong><span>RM1,500</span></div>
    </div>
  </div>
</section>

<section class="refresh">
  <div class="wrap">
    <div class="refresh-banner reveal">
      <div><h3>Refreshments made around your event.</h3><p>Tell us the occasion, estimated guests and preferred style. We can discuss refreshment drinks beyond the standard menu based on request and budget.</p></div>
      <a class="btn btn-light" href="#enquire">Ask for Custom Drinks</a>
    </div>
  </div>
</section>

<section class="gallery">
  <div class="wrap">
    <div class="gallery-head reveal"><span class="eyebrow">Our setup</span><h2 class="section-title">Styled to fit the moment.</h2></div>
    <div class="gallery-grid">
      <figure class="reveal"><img src="data:image/webp;base64," alt="CIKIN.CO outdoor beverage setup"></figure>
      <figure class="reveal"><img src="data:image/webp;base64," alt="CIKIN.CO event beverage bar"></figure>
      <figure class="reveal"><img src="data:image/webp;base64," alt="CIKIN.CO booth setup"></figure>
      <figure class="reveal"><img src="data:image/webp;base64," alt="Guests enjoying a CIKIN.CO event"></figure>
    </div>
  </div>
</section>

<section class="enquiry" id="enquire">
  <div class="wrap enquiry-grid">
    <div class="enquiry-copy reveal">
      <span class="eyebrow">Enquire via WhatsApp</span>
      <h2 class="section-title">Tell us what you’re planning.</h2>
      <p>Choose your service, add the event details and continue directly to WhatsApp. We currently serve Kuala Lumpur, Selangor, Penang and Kedah.</p>
      <div class="locations"><span>Kuala Lumpur</span><span>Selangor</span><span>Penang</span><span>Kedah</span></div>
    </div>
    <form class="form-card reveal" id="enquiryForm">
      <div class="form-grid">
        <div class="field"><label for="name">Name</label><input id="name" required placeholder="Your name"></div>
        <div class="field"><label for="service">Service</label><select id="service"><option>Event Beverage Bar</option><option>Custom Refreshment Drinks</option><option>Cleaning Service</option></select></div>
        <div class="field"><label for="date">Event date</label><input id="date" type="date"></div>
        <div class="field"><label for="location">Location</label><input id="location" placeholder="Event location"></div>
        <div class="field full"><label for="package">Package / Quantity</label><input id="package" placeholder="e.g. 100 cups"></div>
        <div class="field full"><label for="note">Requirements</label><textarea id="note" placeholder="Tell us your event type, preferred drinks or cleaning requirements"></textarea></div>
      </div>
      <button class="wa-submit" type="submit">Continue on WhatsApp</button>
    </form>
  </div>
</section>
</main>

<footer>
  <div class="wrap footer-row">
    <img class="footer-logo" src="data:image/png;base64," alt="CIKIN.CO Event Drinks">
    <div class="footer-contact">
      <a class="icon-link" href="https://www.instagram.com/thecikin.co/" target="_blank" rel="noopener" aria-label="CIKIN.CO Instagram">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a class="footer-phone" href="tel:01159525410">011-59525410</a>
    </div>
  </div>
</footer>
<a class="floating-wa" href="https://wa.me/601159525410" target="_blank" rel="noopener" aria-label="WhatsApp CIKIN.CO"><svg viewBox="0 0 32 32"><path d="M19.11 17.21c-.29-.15-1.72-.85-1.99-.95-.27-.1-.47-.15-.66.15-.19.29-.76.95-.93 1.14-.17.19-.34.22-.63.07-.29-.15-1.23-.45-2.34-1.45-.86-.77-1.45-1.72-1.62-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.19-.29.29-.49.1-.19.05-.36-.02-.51-.07-.15-.66-1.6-.91-2.19-.24-.58-.48-.5-.66-.51h-.56c-.19 0-.51.07-.78.36-.27.29-1.02 1-1.02 2.43s1.05 2.82 1.19 3.01c.15.19 2.06 3.15 4.99 4.42.7.3 1.24.48 1.67.61.7.22 1.34.19 1.84.12.56-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.27-.19-.56-.34zM16.03 4.4c-6.4 0-11.61 5.2-11.61 11.61 0 2.04.53 4.04 1.54 5.79L4.32 27.8l6.14-1.61a11.58 11.58 0 0 0 5.56 1.41h.01c6.4 0 11.61-5.21 11.61-11.61 0-3.1-1.21-6.02-3.4-8.21A11.53 11.53 0 0 0 16.03 4.4zm0 21.24h-.01c-1.72 0-3.4-.46-4.86-1.33l-.35-.21-3.64.95.97-3.55-.23-.36a9.62 9.62 0 0 1-1.48-5.13c0-5.3 4.31-9.62 9.62-9.62 2.57 0 4.98 1 6.8 2.82a9.56 9.56 0 0 1 2.82 6.8c-.02 5.31-4.33 9.63-9.64 9.63z"/></svg></a>
<script>
const packages=document.querySelectorAll('.package');
const packageInput=document.getElementById('package');
packages.forEach(card=>card.addEventListener('click',()=>{packages.forEach(x=>x.classList.remove('selected'));card.classList.add('selected');packageInput.value=card.dataset.package;document.getElementById('enquire').scrollIntoView({behavior:'smooth',block:'start'});}));

document.getElementById('enquiryForm').addEventListener('submit',e=>{e.preventDefault();const get=id=>document.getElementById(id).value.trim();const msg=`Hello CIKIN.CO, I would like to enquire.

Name: ${get('name')}
Service: ${get('service')}
Date: ${get('date')||'-'}
Location: ${get('location')||'-'}
Package / Quantity: ${get('package')||'-'}
Requirements: ${get('note')||'-'}`;window.open('https://wa.me/601159525410?text='+encodeURIComponent(msg),'_blank','noopener');});

const menuData={
  chocolate:{title:'Chocolate',items:['Classic Choco','Choco Berry','Choco Caramel','Choco Vanilla']},
  matcha:{title:'Matcha',items:['Matcha Latte','Strawberry Matcha','Mango Matcha']},
  tea:{title:'Milk Tea & Tea',items:['Taro Milk Tea','Thai Tea','Green Tea']},
  coffee:{title:'Coffee',items:['Customised to budget'],note:'Coffee options can be discussed and customised according to your event budget and requirements.'}
};
const menuTabs=document.querySelectorAll('.menu-tab');
const menuTitle=document.getElementById('menuTitle');
const menuItems=document.getElementById('menuItems');
const menuNote=document.getElementById('menuNote');
menuTabs.forEach(tab=>tab.addEventListener('click',()=>{
  const data=menuData[tab.dataset.menu];
  menuTabs.forEach(x=>x.classList.remove('active'));
  tab.classList.add('active');
  menuTitle.textContent=data.title;
  menuItems.innerHTML=data.items.map(item=>`<li>${item}</li>`).join('');
  menuNote.innerHTML=`<strong>${tab.dataset.menu==='coffee'?'Made around your event':'Need something different?'}</strong>${data.note||'Custom refreshment drinks can be discussed based on your occasion and budget.'}`;
}));

const els=document.querySelectorAll('.reveal');if('IntersectionObserver'in window){const ob=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('show');ob.unobserve(e.target)}}),{threshold:.12});els.forEach(el=>ob.observe(el));}else{els.forEach(el=>el.classList.add('show'));}
</script>
</body>
</html>
