(function(){
  const rail = document.getElementById('carRail') || document.getElementById('cars');
  if(!rail) return;

  let startX = 0, startY = 0;

  rail.addEventListener('touchstart', e=>{
    if(!e.touches || !e.touches[0]) return;
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
  }, {passive:true});

  rail.addEventListener('touchmove', e=>{
    if(!e.touches || !e.touches[0]) return;
    const dx = Math.abs(e.touches[0].clientX - startX);
    const dy = Math.abs(e.touches[0].clientY - startY);

    /* Once the gesture is clearly horizontal, keep it with the carousel.
       Vertical page scrolling is handled outside this swipe rail. */
    if(dx > dy && dx > 6){
      e.stopPropagation();
    }
  }, {passive:true});
})();
