<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<meta content="#111315" name="theme-color"/>
<meta content="Ravanan Auto Hub — browse Perodua models, estimate monthly instalments, enquire about financing, trade-in and delivery assistance." name="description"/>
<title>Ravanan Auto Hub | Ravanan Auto Hub | Your New Perodua Starts Here</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Oswald:wght@500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet"/>
<style>
    :root{
      --ink:#101214;
      --ink2:#171a1d;
      --muted:#6f767d;
      --line:#e7e9eb;
      --paper:#f7f7f5;
      --white:#ffffff;
      --red:#d8212a;
      --red2:#b51018;
      --softred:#fff0f1;
      --green:#16a765;
      --shadow:0 22px 60px rgba(9,13,17,.12);
      --radius:28px;
      --ease:cubic-bezier(.2,.8,.2,1);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth;max-width:100%;overflow-x:hidden;overscroll-behavior-x:none}
    body{
      margin:0;
      font-family:"Manrope",sans-serif;
      color:var(--ink);
      background:var(--white);
      overflow-x:hidden;max-width:100%;overscroll-behavior-x:none;
    }
    body.modal-open{overflow:hidden}
    a{text-decoration:none;color:inherit}
    button,input,select{font:inherit}
    img{display:block;max-width:100%}
    .container{width:min(1180px,calc(100% - 40px));margin:auto}

    /* NAV */
    .nav{
      position:fixed;z-index:1000;top:0;left:0;right:0;
      height:76px;display:flex;align-items:center;
      transition:.35s var(--ease);
      border-bottom:1px solid transparent;
    }
    .nav.scrolled{
      background:rgba(255,255,255,.94);
      backdrop-filter:blur(18px);
      border-color:rgba(16,18,20,.08);
      box-shadow:0 8px 30px rgba(0,0,0,.06);
    }
    .nav-inner{display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:-.03em;color:#fff}
    .nav.scrolled .brand{color:var(--ink)}
    .brand-mark{
      width:42px;height:42px;border-radius:14px;
      background:linear-gradient(145deg,var(--red),#8d0710);
      color:#fff;display:grid;place-items:center;
      font-family:"Oswald";font-size:17px;letter-spacing:.04em;
      box-shadow:0 10px 25px rgba(216,33,42,.28);
    }
    .brand small{display:block;font-size:10px;letter-spacing:.22em;font-weight:700;opacity:.66;margin-top:1px}
    .nav-links{display:flex;align-items:center;gap:28px;color:#fff;font-size:13px;font-weight:700}
    .nav.scrolled .nav-links{color:var(--ink)}
    .nav-links a{position:relative}
    .nav-links a:after{
      content:"";position:absolute;left:0;bottom:-7px;width:0;height:2px;background:var(--red);
      transition:.25s var(--ease)
    }
    .nav-links a:hover:after{width:100%}
    .nav-cta{
      display:inline-flex!important;align-items:center;gap:9px;
      background:var(--red);color:#fff!important;
      padding:12px 17px;border-radius:999px;
      box-shadow:0 10px 22px rgba(216,33,42,.2)
    }
    .nav-cta:after{display:none!important}
    .menu-btn{display:none;background:none;border:0;color:#fff;font-size:24px;padding:8px}
    .nav.scrolled .menu-btn{color:var(--ink)}

    /* HERO */
    .hero{
      min-height:860px;position:relative;color:#fff;display:flex;align-items:center;
      background:#0b0d0f;base64,') center/cover no-repeat;
      overflow:hidden;
    }
    .hero:after{
      content:"";position:absolute;inset:auto 0 0;height:180px;
      background:linear-gradient(transparent,rgba(0,0,0,.28));
      pointer-events:none
    }
    .hero-grid{
      position:absolute;inset:0;opacity:.12;
      background-image:linear-gradient(rgba(255,255,255,.18) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.18) 1px,transparent 1px);
      background-size:72px 72px;
      mask-image:linear-gradient(to right,#000,transparent 72%);
    }
    .hero-content{position:relative;z-index:2;padding-top:76px;max-width:770px}
    .eyebrow{
      display:inline-flex;align-items:center;gap:9px;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;
      margin-bottom:22px
    }
    .eyebrow:before{content:"";width:38px;height:2px;background:var(--red)}
    h1{
      font-family:"Oswald";font-weight:700;text-transform:uppercase;
      margin:0;font-size:clamp(64px,8vw,118px);line-height:.88;letter-spacing:-.035em;
    }
    .hero h1 span{color:var(--red)}
    .hero-copy{font-size:18px;line-height:1.75;max-width:620px;color:rgba(255,255,255,.78);margin:30px 0}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap}
    .btn{
      border:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:10px;
      min-height:54px;padding:0 22px;border-radius:999px;font-weight:800;font-size:14px;
      transition:.25s var(--ease)
    }
    .btn:hover{transform:translateY(-2px)}
    .btn-primary{background:var(--red);color:#fff;box-shadow:0 16px 34px rgba(216,33,42,.3)}
    .btn-primary:hover{background:var(--red2)}
    .btn-glass{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(12px)}
    .hero-stats{
      margin-top:60px;display:grid;grid-template-columns:repeat(4,max-content);gap:0;
      border-top:1px solid rgba(255,255,255,.18);padding-top:26px;
    }
    .hero-stat{padding-right:30px;margin-right:30px;border-right:1px solid rgba(255,255,255,.18)}
    .hero-stat:last-child{border:0;margin:0;padding:0}
    .hero-stat strong{display:block;font-size:15px}
    .hero-stat span{font-size:12px;color:rgba(255,255,255,.56)}
    .scroll-cue{
      position:absolute;z-index:3;right:34px;bottom:30px;display:flex;align-items:center;gap:10px;
      font-size:11px;text-transform:uppercase;letter-spacing:.18em;color:rgba(255,255,255,.62);
      transform:rotate(90deg);transform-origin:right bottom
    }

    /* COMMON */
    section{padding:112px 0;max-width:100%;overflow-x:clip}
    .section-kicker{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--red);margin-bottom:12px}
    .section-title{
      font-family:"Oswald";text-transform:uppercase;
      margin:0;font-size:clamp(42px,5vw,68px);line-height:1;letter-spacing:-.025em
    }
    .section-sub{color:var(--muted);line-height:1.75;max-width:660px;margin:18px 0 0;font-size:15px}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:42px}
    .text-link{font-weight:800;font-size:13px;display:inline-flex;gap:8px;align-items:center;color:var(--red)}

    /* SHOWROOM */
    .showroom{background:var(--paper)}
    .cars-wrap{position:relative;max-width:100%;overflow:hidden}
    .cars{
      display:grid;grid-auto-flow:column;grid-auto-columns:minmax(310px,1fr);
      overflow-x:auto;overscroll-behavior-x:contain;gap:18px;scroll-snap-type:x mandatory;padding:5px 2px 25px;
      scrollbar-width:none;
    }
    .cars::-webkit-scrollbar{display:none}
    .car-card{
      scroll-snap-align:start;background:#fff;border-radius:24px;overflow:hidden;
      box-shadow:0 10px 35px rgba(0,0,0,.06);border:1px solid rgba(17,19,21,.06);
      transition:.35s var(--ease);min-width:0
    }
    .car-card:hover{transform:translateY(-7px);box-shadow:var(--shadow)}
    .car-media{height:230px;position:relative;overflow:hidden;background:#ddd}
    .car-media img{width:100%;height:100%;object-fit:cover;transition:.55s var(--ease)}
    .car-card:hover .car-media img{transform:scale(1.045)}
    .badge{
      position:absolute;left:16px;top:16px;background:rgba(17,19,21,.88);color:#fff;
      border-radius:999px;padding:8px 11px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
      backdrop-filter:blur(10px)
    }
    .car-body{padding:22px}
    .car-model{font-size:19px;font-weight:800;line-height:1.25;letter-spacing:-.025em;min-height:48px}
    .car-meta{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}
    .chip{font-size:10px;font-weight:700;background:#f1f2f3;color:#596067;padding:7px 9px;border-radius:999px}
    .price-row{display:flex;justify-content:space-between;align-items:end;gap:12px;border-top:1px solid var(--line);padding-top:18px}
    .price small{display:block;color:var(--muted);font-size:10px;font-weight:700;margin-bottom:3px}
    .price strong{font-size:22px;letter-spacing:-.04em}
    .monthly{text-align:right}
    .monthly small{display:block;color:var(--muted);font-size:9px}
    .monthly strong{color:var(--red);font-size:15px}
    .card-actions{display:grid;grid-template-columns:1fr 50px;gap:10px;margin-top:17px}
    .car-view{
      border:0;background:var(--ink);color:#fff;border-radius:14px;height:48px;font-weight:800;cursor:pointer
    }
    .car-wa{border:1px solid var(--line);background:#fff;border-radius:14px;display:grid;place-items:center;color:var(--green);font-size:20px}
    .slider-controls{display:flex;gap:8px}
    .round-btn{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:#fff;cursor:pointer}

    /* EXPERIENCE STRIP */
    .benefits{
      background:var(--ink);color:#fff;padding:0
    }
    .benefit-grid{display:grid;grid-template-columns:repeat(4,1fr)}
    .benefit{padding:34px 28px;border-right:1px solid rgba(255,255,255,.08);display:flex;gap:15px}
    .benefit:last-child{border-right:0}
    .benefit i{color:var(--red);font-size:22px;margin-top:3px}
    .benefit strong{display:block;font-size:13px;margin-bottom:4px}
    .benefit span{font-size:11px;color:rgba(255,255,255,.52);line-height:1.5}

    /* FINDER */
    .finder-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:60px;align-items:center}
    .finder-visual{position:relative}
    .finder-main{
      height:610px;border-radius:36px;overflow:hidden;
      box-shadow:var(--shadow)
    }
    .finder-main img{width:100%;height:100%;object-fit:cover}
    .floating-note{
      position:absolute;right:-30px;bottom:42px;background:#fff;border-radius:22px;padding:20px 22px;
      box-shadow:var(--shadow);width:250px
    }
    .floating-note small{color:var(--muted);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em}
    .floating-note strong{font-family:"Oswald";font-size:26px;display:block;margin:4px 0}
    .finder-options{display:grid;gap:12px;margin-top:30px}
    .finder-option{
      width:100%;text-align:left;background:#fff;border:1px solid var(--line);border-radius:20px;padding:18px;
      display:flex;align-items:center;justify-content:space-between;cursor:pointer;transition:.25s var(--ease)
    }
    .finder-option.active{border-color:var(--red);background:var(--softred);transform:translateX(5px)}
    .finder-left{display:flex;align-items:center;gap:15px}
    .finder-icon{width:44px;height:44px;border-radius:14px;background:#f2f3f4;display:grid;place-items:center}
    .finder-option.active .finder-icon{background:var(--red);color:#fff}
    .finder-option strong{display:block;font-size:14px}
    .finder-option small{font-size:11px;color:var(--muted)}

    /* CALCULATOR */
    .calculator{background:linear-gradient(135deg,#0f1113,#1e2226);color:#fff;overflow:hidden;position:relative}
    .calculator:before{
      content:"";position:absolute;width:520px;height:520px;border-radius:50%;
      right:-190px;top:-230px;background:radial-gradient(circle,rgba(216,33,42,.36),transparent 68%)
    }
    .calc-grid{position:relative;display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center}
    .calc-note{color:rgba(255,255,255,.56);line-height:1.7;font-size:12px;margin-top:24px}
    .calc-card{
      background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(18px);
      padding:30px;border-radius:30px
    }
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .field label{display:block;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:8px}
    .field input,.field select{
      width:100%;height:52px;border-radius:14px;border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.08);color:#fff;padding:0 14px;outline:0
    }
    .field select option{color:#111}
    .calc-result{
      margin-top:16px;background:#fff;color:var(--ink);border-radius:20px;padding:22px;
      display:flex;justify-content:space-between;align-items:end;gap:15px
    }
    .calc-result span{font-size:11px;color:var(--muted);font-weight:700}
    .calc-result strong{display:block;font-family:"Oswald";font-size:38px;color:var(--red);line-height:1}
    .calc-result em{font-style:normal;font-size:11px;color:var(--muted)}

    /* DELIVERIES */
    .delivery-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;margin-top:38px}
    .delivery-main,.delivery-small{position:relative;border-radius:28px;overflow:hidden;background:#ddd}
    .delivery-main{height:520px}
    .delivery-side{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .delivery-small{height:251px}
    .delivery-main img,.delivery-small img{width:100%;height:100%;object-fit:cover;transition:.5s var(--ease)}
    .delivery-main:hover img,.delivery-small:hover img{transform:scale(1.035)}
    .delivery-overlay{
      position:absolute;inset:auto 0 0;padding:60px 22px 22px;
      background:linear-gradient(transparent,rgba(0,0,0,.85));color:#fff
    }
    .delivery-overlay strong{display:block;font-size:17px}
    .delivery-overlay span{font-size:11px;color:rgba(255,255,255,.66)}

    /* ADVISOR */
    .advisor{background:var(--paper)}
    .advisor-card{
      display:grid;grid-template-columns:1fr 1fr;min-height:600px;background:#fff;border-radius:36px;overflow:hidden;
      box-shadow:var(--shadow)
    }
    .advisor-photo{
      background:url('data:image/jpeg;base64,') center/cover no-repeat;
      min-height:460px
    }
    .advisor-copy{padding:64px;display:flex;flex-direction:column;justify-content:center}
    .advisor-list{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:28px 0 32px}
    .advisor-list div{padding:13px 0;border-bottom:1px solid var(--line);font-size:12px;font-weight:700}
    .advisor-list i{color:var(--red);margin-right:8px}

    /* CTA */
    .final-cta{
      padding:90px 0;background:var(--red);color:#fff;position:relative;overflow:hidden
    }
    .final-cta:before{
      content:"PA";position:absolute;font-family:"Oswald";font-size:380px;font-weight:700;line-height:.7;
      right:-30px;bottom:-70px;color:rgba(255,255,255,.07)
    }
    .cta-flex{position:relative;display:flex;justify-content:space-between;align-items:center;gap:40px}
    .final-cta .section-title{max-width:650px}
    .btn-white{background:#fff;color:var(--ink);min-width:210px}

    footer{background:#0b0d0f;color:#fff;padding:42px 0 110px}
    .footer-grid{display:flex;justify-content:space-between;gap:30px;align-items:end}
    .footer-copy{font-size:11px;color:rgba(255,255,255,.42);max-width:520px;line-height:1.7}
    .socials{display:flex;gap:9px}
    .socials a{width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.14);display:grid;place-items:center;color:#fff}
    .disclaimer{margin-top:30px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);font-size:10px;color:rgba(255,255,255,.34);line-height:1.6}

    /* MOBILE BAR */
    .mobile-bar{
      display:none;position:fixed;z-index:950;left:10px;right:10px;bottom:10px;background:rgba(12,14,16,.95);
      border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:7px;backdrop-filter:blur(16px);
      box-shadow:0 15px 45px rgba(0,0,0,.25)
    }
    .mobile-bar a{flex:1;color:#fff;text-align:center;font-size:9px;font-weight:700;padding:7px 4px}
    .mobile-bar i{display:block;font-size:16px;margin-bottom:4px}
    .mobile-bar .wa{background:var(--green);border-radius:13px}

    /* MODAL */
    .modal{position:fixed;z-index:2000;inset:0;width:100vw;height:100dvh;background:rgba(5,7,9,.72);backdrop-filter:blur(12px);display:none;padding:20px;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain}
    .modal.open{display:flex;align-items:flex-start;justify-content:center}
    .modal-card{
      width:min(1020px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:30px;
      position:relative;box-shadow:0 40px 100px rgba(0,0,0,.35)
    }
    .modal-close{
      position:fixed;z-index:3000;right:max(14px,env(safe-area-inset-right));top:max(14px,env(safe-area-inset-top));width:42px;height:42px;border-radius:50%;border:0;background:rgba(255,255,255,.92);
      cursor:pointer;font-size:18px;box-shadow:0 6px 25px rgba(0,0,0,.15)
    }
    .modal-grid{display:grid;grid-template-columns:1.1fr .9fr;min-height:600px}
    .modal-photo{min-height:600px;background:#ddd}
    .modal-photo img{width:100%;height:100%;object-fit:cover}
    .modal-info{padding:48px 38px;display:flex;flex-direction:column;justify-content:center}
    .modal-info h3{font-family:"Oswald";text-transform:uppercase;font-size:38px;line-height:1.03;margin:10px 0}
    .modal-price{font-size:26px;font-weight:800}
    .modal-month{font-size:13px;color:var(--red);font-weight:800;margin-top:4px}
    .modal-features{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:24px 0}
    .modal-feature{background:#f4f5f5;border-radius:14px;padding:13px;font-size:11px;font-weight:700}
    .modal-buttons{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .modal-buttons .btn{border-radius:14px;padding:0 14px}
    .modal-back{display:none;position:fixed;z-index:3000;left:max(14px,env(safe-area-inset-left));top:max(14px,env(safe-area-inset-top));height:42px;border:0;border-radius:999px;background:#fff;padding:0 14px;font-weight:800;box-shadow:0 8px 26px rgba(0,0,0,.18)}
    .modal-gallery{display:flex;gap:8px;overflow-x:auto;max-width:100%;margin:14px 0 2px;scrollbar-width:none}.modal-gallery::-webkit-scrollbar{display:none}.modal-thumb{width:68px;height:56px;flex:0 0 auto;border:2px solid transparent;border-radius:10px;overflow:hidden;padding:0;background:#eee}.modal-thumb.active{border-color:var(--red)}.modal-thumb img{width:100%;height:100%;object-fit:cover}
    .btn-outline{background:#fff;border:1px solid var(--line);color:var(--ink)}
    .btn-wa{background:var(--green);color:#fff}

    /* ANIMATIONS */
    .reveal{opacity:0;transform:translateY(26px);transition:opacity .75s var(--ease),transform .75s var(--ease)}
    .reveal.visible{opacity:1;transform:none}
    .delay1{transition-delay:.08s}.delay2{transition-delay:.16s}.delay3{transition-delay:.24s}
    @keyframes floaty{50%{transform:translateY(-8px)}}
    .floating-note{animation:floaty 4s ease-in-out infinite}

    /* RESPONSIVE */
    @media (max-width:980px){
      .customer-social .container{grid-template-columns:1fr!important}
      .nav-links{display:none}
      .menu-btn{display:block}
      .nav.mobile-open{background:#fff}
      .nav.mobile-open .brand,.nav.mobile-open .menu-btn{color:var(--ink)}
      .nav.mobile-open .nav-links{
        display:flex;position:absolute;left:20px;right:20px;top:70px;flex-direction:column;align-items:stretch;
        background:#fff;color:var(--ink);padding:18px;border-radius:20px;box-shadow:var(--shadow)
      }
      .hero{min-height:760px;background-position:62% center}
      .hero-stats{grid-template-columns:1fr 1fr;gap:18px}
      .hero-stat{border:0;padding:0;margin:0}
      .benefit-grid{grid-template-columns:1fr 1fr}
      .benefit:nth-child(2){border-right:0}
      .benefit:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.08)}
      .finder-grid,.calc-grid{grid-template-columns:1fr}
      .finder-visual{order:2}
      .finder-main{height:470px}
      .floating-note{right:18px}
      .delivery-grid{grid-template-columns:1fr}
      .advisor-card{grid-template-columns:1fr}
      .advisor-copy{padding:44px}
      .cta-flex{align-items:flex-start;flex-direction:column}
    }

    @media (max-width:700px){
      .container{width:min(100% - 28px,1180px)}
      section{padding:82px 0}
      .nav{height:66px}
      .brand-mark{width:38px;height:38px;border-radius:12px}
      .brand{font-size:13px}
      .hero{min-height:720px;align-items:flex-end;padding-bottom:66px;background-position:62% center}
      .hero:before{
        content:"";position:absolute;inset:0;
        background:linear-gradient(to top,rgba(8,9,10,.94) 0%,rgba(8,9,10,.62) 52%,rgba(8,9,10,.18) 100%);
      }
      .hero-content{padding-top:110px}
      h1{font-size:clamp(56px,18vw,78px)}
      .hero-copy{font-size:14px;line-height:1.65;margin:22px 0}
      .hero-actions .btn{width:100%}
