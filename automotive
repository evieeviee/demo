<script>
  const nav = document.getElementById('nav');
  const menuBtn = document.getElementById('menuBtn');
  const navLinks = document.getElementById('navLinks');

  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  });

  menuBtn.addEventListener('click', () => {
    nav.classList.toggle('mobile-open');
    menuBtn.innerHTML = nav.classList.contains('mobile-open')
      ? '<i class="fa-solid fa-xmark"></i>'
      : '<i class="fa-solid fa-bars"></i>';
  });

  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    nav.classList.remove('mobile-open');
    menuBtn.innerHTML = '<i class="fa-solid fa-bars"></i>';
  }));

  // Reveal animation
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, {threshold:.12});
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Showroom arrows
  const cars = document.getElementById('cars');
  document.getElementById('nextCar').addEventListener('click', () => cars.scrollBy({left:350,behavior:'smooth'}));
  document.getElementById('prevCar').addEventListener('click', () => cars.scrollBy({left:-350,behavior:'smooth'}));

  // Car detail modal
  const modal = document.getElementById('carModal');
  const modalClose = document.getElementById('modalClose');
  const modalImage = document.getElementById('modalImage');
  const modalName = document.getElementById('modalName');
  const modalPrice = document.getElementById('modalPrice');
  const modalMonth = document.getElementById('modalMonth');
  const modalFeatures = document.getElementById('modalFeatures');
  const modalGallery = document.getElementById('modalGallery');
  const modalWa = document.getElementById('modalWa');
  const modalCalc = document.getElementById('modalCalc');

  function openCar(card){
    const name = card.dataset.name;
    const price = card.dataset.price;
    const month = card.dataset.month;
    const image = card.dataset.image;
    const images = (card.dataset.images || image).split('|');
    const tags = card.dataset.tags.split('|');

    modalName.textContent = name;
    modalPrice.textContent = price;
    modalMonth.textContent = month;
    modalImage.src = images[0];
    modalGallery.innerHTML = '';
    images.forEach((src,i)=>{
      const b=document.createElement('button'); b.type='button'; b.className='modal-thumb'+(i===0?' active':'');
      b.innerHTML=`<img src="${src}" alt="${name} view ${i+1}">`;
      b.addEventListener('click',()=>{ modalImage.src=src; modalGallery.querySelectorAll('.modal-thumb').forEach(x=>x.classList.remove('active')); b.classList.add('active'); });
      modalGallery.appendChild(b);
    });
    modalImage.alt = name;
    modalFeatures.innerHTML = tags.map(t => `<div class="modal-feature">${t}</div>`).join('');
    modalWa.href = `https://wa.me/60168083598?text=${encodeURIComponent(`Hi, I'm interested in the ${name} shown on your website. Can you share the latest availability, promotion and financing information?`)}`;

    modal.classList.add('open');
    document.body.classList.add('modal-open');
  }

  function closeModal(){
    modal.classList.remove('open');
    document.body.classList.remove('modal-open');
  }

  document.querySelectorAll('.car-card .car-view').forEach(btn => {
    btn.addEventListener('click', () => openCar(btn.closest('.car-card')));
  });

  modalClose.addEventListener('click', closeModal);
  
  
  modal.addEventListener('click', e => { if(e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });


  // Finder
  const finderOptions = Array.from(document.querySelectorAll('.finder-option'));
  const finderWhatsApp = document.getElementById('finderWhatsApp');

  function selectFinderOption(btn){
    finderOptions.forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-pressed','false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-pressed','true');

    const choice = btn.dataset.choice || '';
    finderWhatsApp.href = `https://wa.me/60168083598?text=${encodeURIComponent(
      `Hi, ${choice}. Can you recommend a suitable Perodua model and share the financing information?`
    )}`;
  }

  finderOptions.forEach((btn,index) => {
    btn.type = 'button';
    btn.setAttribute('aria-pressed', index === 0 ? 'true' : 'false');
    btn.addEventListener('click', function(e){
      e.preventDefault();
      selectFinderOption(this);
    });
  });

  // Flat-rate indicative hire purchase calculator
  const carPrice = document.getElementById('carPrice');
  const deposit = document.getElementById('deposit');
  const years = document.getElementById('years');
  const rate = document.getElementById('rate');
  const monthlyResult = document.getElementById('monthlyResult');
  const loanInfo = document.getElementById('loanInfo');
  const calcWhatsApp = document.getElementById('calcWhatsApp');

  function calculate(){
    const price = Math.max(0, Number(carPrice.value) || 0);
    const dp = Math.min(100, Math.max(0, Number(deposit.value) || 0));
    const yrs = Math.max(1, Number(years.value) || 1);
    const interest = Math.max(0, Number(rate.value) || 0);

    const principal = price * (1 - dp / 100);
    const totalInterest = principal * (interest / 100) * yrs;
    const total = principal + totalInterest;
    const monthly = total / (yrs * 12);

    monthlyResult.textContent = `RM ${Math.round(monthly).toLocaleString('en-MY')}`;
    loanInfo.textContent = `Estimated financing: RM ${Math.round(principal).toLocaleString('en-MY')}`;
    calcWhatsApp.href = `https://wa.me/60168083598?text=${encodeURIComponent(
      `Hi, I used the website loan calculator. Vehicle price: RM ${price.toLocaleString('en-MY')}, down payment: ${dp}%, period: ${yrs} years, interest assumption: ${interest}%. Estimated monthly: RM ${Math.round(monthly).toLocaleString('en-MY')}. Can you advise me on the actual financing?`
    )}`;
  }

  [carPrice,deposit,years,rate].forEach(el => el.addEventListener('input', calculate));
  calculate();
</script>
