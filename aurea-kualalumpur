/* MODERN VINTAGE EDITORIAL LAYER */
:root{
  --paper:#F6F3ED;
  --oxblood:#622424;
}
body{background:var(--paper)}
.display{letter-spacing:-.032em}
.kicker{letter-spacing:.22em}
.editorial-no{
