/* PRELOADER */
.preloader{
  position:fixed;inset:0;z-index:9999;
  background:var(--satin);
  display:grid;place-items:center;
  overflow:hidden;
  transition:opacity .75s ease,visibility .75s ease;
}
.preloader.hide{opacity:0;visibility:hidden}

.loader-stage{
  position:relative;
  z-index:2;
  width:min(430px,84vw);
  min-height:330px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:44px 32px;
}

.loader-logo{
  width:min(170px,42vw);
  height:auto;
  object-fit:contain;
  animation:loaderLogo 1.8s ease-in-out infinite alternate;
}

.loader-mini-stripe{
  width:86px;
  height:6px;
  margin:0 auto 24px;
  background:repeating-linear-gradient(
    90deg,
    var(--velvet) 0 11px,
    var(--velvet) 11px 20px,
    var(--blue) 20px 29px,
    var(--blue) 29px 38px
  );
  opacity:.82;
}

.loader-mini-stripe.bottom{
  width:54px;
  height:5px;
  margin:22px auto 0;
  opacity:.62;
}

.loader-line{
  width:132px;height:1px;
  margin:22px auto 12px;
  background:rgba(98,36,36,.16);
  overflow:hidden;
}
.loader-line:after{
  content:"";
  display:block;
  width:42px;height:100%;
  background:var(--velvet);
  animation:loaderLine 1.8s ease-in-out infinite;
}

.loader-copy{
  font-size:8px;
  letter-spacing:.28em;
  text-transform:uppercase;
  color:var(--velvet);
}

.loader-whisper{
  margin-top:16px;
  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:20px;
  font-style:italic;
  color:rgba(98,36,36,.76);
}

.loader-stage:before,
.loader-stage:after{
  content:"";
  position:absolute;
  top:50%;
  width:44px;
  height:1px;
  background:rgba(98,36,36,.16);
}
.loader-stage:before{left:0}
.loader-stage:after{right:0}

@keyframes loaderLogo{
  from{transform:translateY(2px);opacity:.92}
  to{transform:translateY(-2px);opacity:1}
}
@keyframes loaderLine{
  0%{transform:translateX(-48px)}
  100%{transform:translateX(142px)}
}

.preloader.hide .loader-stage{
  animation:loaderExit .55s ease forwards;
}
@keyframes loaderExit{
  to{transform:translateY(-6px);opacity:0}
}

