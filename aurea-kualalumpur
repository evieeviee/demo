<script>
window.addEventListener("load",()=>setTimeout(()=>document.querySelector(".preloader")?.classList.add("hide"),420));

const menuBtn=document.querySelector(".menu-toggle"),mobileMenu=document.querySelector(".mobile-menu");
function setMenu(open){
  if(!menuBtn||!mobileMenu)return;
  mobileMenu.classList.toggle("open",open);
  menuBtn.classList.toggle("open",open);
  menuBtn.setAttribute("aria-expanded",String(open));
  document.body.classList.toggle("locked",open);
}
menuBtn?.setAttribute("aria-expanded","false");
menuBtn?.addEventListener("click",()=>setMenu(!mobileMenu.classList.contains("open")));

function routeTo(page,push=true){
  const valid=["home","suites","location","terms","faq","book"];
  if(!valid.includes(page)) page="home";
  document.querySelectorAll(".page-view").forEach(v=>v.classList.toggle("active",v.dataset.page===page));
  document.querySelectorAll(".nav a").forEach(a=>a.classList.toggle("active",a.dataset.route===page));
  setMenu(false);
  window.scrollTo({top:0,behavior:"smooth"});
  if(push && location.hash!=="#"+page) history.pushState({page},"","#"+page);
  setTimeout(refreshReveals,50);
}

document.addEventListener("click",e=>{
  const link=e.target.closest("[data-route]");
  if(!link)return;
  e.preventDefault();
  routeTo(link.dataset.route,true);
});
window.addEventListener("popstate",()=>routeTo((location.hash||"#home").slice(1),false));
document.addEventListener("keydown",e=>{
  if(e.key==="Escape" && mobileMenu?.classList.contains("open")) setMenu(false);
});

if(location.hash) routeTo(location.hash.slice(1),false);

document.querySelectorAll(".faq-item").forEach(item=>{
 const q=item.querySelector(".faq-q"),a=item.querySelector(".faq-a");
 const sync=()=>a.style.maxHeight=item.classList.contains("open")?a.scrollHeight+"px":"0";
 sync();q.addEventListener("click",()=>{item.classList.toggle("open");sync()});
});

let observer;
function refreshReveals(){
  if(observer)observer.disconnect();
  observer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("on");observer.unobserve(e.target)}}),{threshold:.08});
  document.querySelectorAll(".page-view.active .reveal,.final-cta .reveal").forEach(el=>{el.classList.remove("on");observer.observe(el)});
}
refreshReveals();

const lb=document.querySelector(".lightbox"),lbImg=document.querySelector(".lightbox-img"),lbCap=document.querySelector(".lightbox-caption"),lbCount=document.querySelector(".lb-count");
let gallery=[],gi=0,touchX=0;
function openGallery(el){
 const group=el.dataset.group||"all";
 gallery=[...document.querySelectorAll(`.page-view.active [data-gallery][data-group="${group}"]`)];
 gi=Math.max(0,gallery.indexOf(el));showGallery();lb.classList.add("open");document.body.classList.add("locked");
}
function showGallery(){if(!gallery.length)return;const el=gallery[gi],im=el.querySelector("img");lbImg.style.animation="none";void lbImg.offsetWidth;lbImg.style.animation="lbIn .35s ease both";lbImg.src=im.src;lbImg.alt=im.alt||"";lbCap.textContent=el.dataset.caption||im.alt||"";lbCount.textContent=`${String(gi+1).padStart(2,"0")} / ${String(gallery.length).padStart(2,"0")}`}
function moveGallery(d){gi=(gi+d+gallery.length)%gallery.length;showGallery()}
function closeGallery(){lb.classList.remove("open");document.body.classList.remove("locked")}
document.querySelectorAll("[data-gallery]").forEach(el=>el.addEventListener("click",()=>openGallery(el)));
document.querySelector(".lb-prev")?.addEventListener("click",()=>moveGallery(-1));
document.querySelector(".lb-next")?.addEventListener("click",()=>moveGallery(1));
document.querySelector(".lb-close")?.addEventListener("click",closeGallery);
lb?.addEventListener("click",e=>{if(e.target===lb)closeGallery()});
document.addEventListener("keydown",e=>{if(!lb?.classList.contains("open"))return;if(e.key==="ArrowLeft")moveGallery(-1);if(e.key==="ArrowRight")moveGallery(1);if(e.key==="Escape")closeGallery()});
lb?.addEventListener("touchstart",e=>touchX=e.changedTouches[0].clientX,{passive:true});
lb?.addEventListener("touchend",e=>{let dx=e.changedTouches[0].clientX-touchX;if(Math.abs(dx)>45)moveGallery(dx>0?-1:1)},{passive:true});

document.querySelectorAll(".place-tab").forEach(btn=>btn.addEventListener("click",()=>{
 document.querySelectorAll(".place-tab").forEach(b=>b.classList.remove("active"));btn.classList.add("active");
 const cat=btn.dataset.cat;
 document.querySelectorAll(".map-pin:not(.home)").forEach(p=>p.classList.toggle("hidden",cat!=="all"&&p.dataset.cat!==cat));
 document.querySelectorAll(".place-card").forEach(p=>p.style.display=(cat==="all"||p.dataset.cat===cat)?"grid":"none");
 const rail=btn.closest(".place-tabs");
 if(rail){
   const left=btn.offsetLeft-(rail.clientWidth-btn.offsetWidth)/2;
   rail.scrollTo({left:Math.max(0,left),behavior:"smooth"});
 }
}));


function selectNearbyPlace(placeId, category){
  const tab=document.querySelector(`.place-tab[data-cat="${category}"]`);
  if(tab) tab.click();

  document.querySelectorAll(".place-card").forEach(c=>c.classList.remove("focused"));
  document.querySelectorAll(".map-pin").forEach(p=>p.classList.remove("active-pin"));

  const card=document.querySelector(`.place-card[data-place="${placeId}"]`);
  const pin=document.querySelector(`.map-pin[data-place="${placeId}"]`);

  card?.classList.add("focused");
  pin?.classList.add("active-pin");

  if(card){
    setTimeout(()=>card.scrollIntoView({behavior:"smooth",block:"nearest"}),180);
  }
}
document.querySelectorAll(".map-pin[data-place]").forEach(pin=>{
  pin.addEventListener("click",e=>{
    e.preventDefault();
    selectNearbyPlace(pin.dataset.place,pin.dataset.cat);
  });
});
document.querySelectorAll(".place-go[data-map-query]").forEach(btn=>{
  btn.addEventListener("click",e=>{
    e.preventDefault();
    e.stopPropagation();
    const q=encodeURIComponent(btn.dataset.mapQuery);
    window.open(`https://www.google.com/maps/search/?api=1&query=${q}`,"_blank","noopener");
  });
});
document.querySelectorAll(".place-card[data-place]").forEach(card=>{
  card.addEventListener("click",e=>{
    if(e.target.closest(".place-go")) return;
    const pin=document.querySelector(`.map-pin[data-place="${card.dataset.place}"]`);
    if(pin){
      document.querySelectorAll(".map-pin").forEach(p=>p.classList.remove("active-pin"));
      pin.classList.add("active-pin");
    }
  });
});


const lookbookData=[
  {src:'data:image/jpeg;base64,',title:"Living",alt:"Aurea living room"},
  {src:'data:image/jpeg;base64,',title:"Kitchen",alt:"Aurea kitchen"},
  {src:'data:image/jpeg;base64,',title:"Bedroom",alt:"Aurea bedroom"},
  {src:'data:image/jpeg;base64,',title:"Bath",alt:"Aurea ensuite bathroom"}
];
document.querySelectorAll(".lookbook-tab").forEach(tab=>tab.addEventListener("click",()=>{
  const i=Number(tab.dataset.look||0),img=document.querySelector("#lookbookImage");
  document.querySelectorAll(".lookbook-tab").forEach(t=>t.classList.remove("active"));
  tab.classList.add("active");
  if(img){
    img.style.opacity=".25";
    img.style.transform="scale(1.02)";
    setTimeout(()=>{
      img.src=lookbookData[i].src;img.alt=lookbookData[i].alt;
      document.querySelector("#lookbookTitle").textContent=lookbookData[i].title;
      document.querySelector("#lookbookCount").textContent=String(i+1).padStart(2,"0")+" / 04";
      img.style.opacity="1";img.style.transform="scale(1)";
    },160);
  }
}));

const form=document.querySelector("#bookingForm");
if(form){
 const today=new Date();today.setMinutes(today.getMinutes()-today.getTimezoneOffset());const d=today.toISOString().split("T")[0];
 document.querySelector("#checkin").min=d;document.querySelector("#checkout").min=d;
 document.querySelector("#checkin").addEventListener("change",e=>document.querySelector("#checkout").min=e.target.value||d);
 form.addEventListener("submit",e=>{
  e.preventDefault();const f=new FormData(form);
  const msg=`Hi Aurea Kuala Lumpur, I'd like to enquire about a stay.

Name: ${f.get("name")}
Check-in: ${f.get("checkin")}
Check-out: ${f.get("checkout")}
Guests: ${f.get("guests")}

Request:
${f.get("notes")||"None"}`;
  window.open("https://wa.me/60168083598?text="+encodeURIComponent(msg),"_blank");
 });
}
</script>
</body>
