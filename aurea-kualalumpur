.lookbook-tab{
  flex:0 0 auto;border:0;border-right:1px solid var(--line);background:transparent;
  padding:13px 18px;font-size:9px;letter-spacing:.14em;text-transform:uppercase;
  cursor:pointer;color:var(--ink)
