  font-size:18px;color:var(--velvet);letter-spacing:.02em
}
.journal-head{
  display:flex;align-items:center;gap:14px;margin-bottom:18px
}
.journal-head:after{
  content:"";height:1px;background:rgba(98,36,36,.28);flex:1
}
.script-accent{
  font-family:"Cormorant Garamond",Georgia,serif;
  font-style:italic;font-size:26px;color:var(--velvet);line-height:1.1
}
.vintage-note{
  display:inline-flex;align-items:center;gap:9px;padding:8px 0;
  border-top:1px solid rgba(98,36,36,.24);border-bottom:1px solid rgba(98,36,36,.24);
  font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--velvet)
}
.vintage-note:before{content:"";width:26px;height:5px;background:repeating-linear-gradient(90deg,var(--velvet) 0 8px,var(--blue) 8px 16px)}
.page-hero .hero-meta{
  display:flex;gap:14px;flex-wrap:wrap;margin-bottom:15px;
  font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.78)
}
.page-hero .hero-meta span{display:flex;align-items:center;gap:8px}
.page-hero .hero-meta span:before{content:"";width:18px;height:1px;background:rgba(255,255,255,.5)}
.page-hero h1{max-width:760px}
.page-hero-content{max-width:900px}

/* editorial split section */
.editorial-split{
  display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(30px,6vw,88px);align-items:center
}
.editorial-split.reverse{grid-template-columns:1.18fr .82fr}
.editorial-photo{
  position:relative;overflow:hidden;min-height:540px;cursor:zoom-in
}
.editorial-photo img{height:100%;object-fit:cover;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.editorial-photo:hover img{transform:scale(1.035)}
.editorial-photo:after{
  content:"";position:absolute;inset:0;border:1px solid rgba(255,255,255,.18);pointer-events:none
}
.editorial-copy h2{font-size:clamp(42px,5vw,72px);line-height:.98;margin:12px 0 18px}
.editorial-copy p{color:var(--muted);font-size:14px;line-height:1.9}
