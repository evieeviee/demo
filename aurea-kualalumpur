<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#F2F1EB">
<title>Aurea Kuala Lumpur · Demo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Livvic:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --velvet:#622424;--champagne:#D1C3B2;--satin:#F2F1EB;--blue:#C1DCDE;--ink:#1E1A19;
  --white:#fff;--muted:#706965;--line:rgba(30,26,25,.14);--max:1380px;
  --pad:clamp(20px,4vw,64px);--shadow:0 18px 60px rgba(30,26,25,.11)
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
html,body{max-width:100%;overflow-x:hidden} body{
  margin:0;padding-top:88px;background:var(--satin);color:var(--ink);
  font-family:"Livvic","Avenir Next","Segoe UI",sans-serif;overflow-x:hidden
}
body.locked{overflow:hidden}
img{display:block;width:100%}
a{text-decoration:none;color:inherit}
button,input,textarea,select{font:inherit}
button{color:inherit}
.wrap{width:min(var(--max),calc(100% - var(--pad)*2));margin:auto}
.kicker{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--velvet);font-weight:600}
.display{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;letter-spacing:-.025em}
.section{padding:clamp(72px,8vw,120px) 0}
.section-head{display:grid;grid-template-columns:.55fr 1fr;gap:48px;margin-bottom:42px;align-items:start}
.section-head h2{font-size:clamp(38px,4.4vw,68px);line-height:1;margin:0}
.section-head p{max-width:670px;margin:0;color:var(--muted);line-height:1.8;font-size:15px}
.hairline{border-top:1px solid var(--line)}
.btn{min-height:48px;padding:0 20px;border-radius:999px;border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;cursor:pointer;transition:.25s ease}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:var(--velvet);color:#fff;box-shadow:0 10px 28px rgba(98,36,36,.15)}
.btn-primary:hover{background:#4f1c1c}
.btn-ghost{
  border-color:rgba(255,255,255,.92);background:rgba(242,241,235,.96);
  color:var(--velvet);box-shadow:0 9px 26px rgba(30,26,25,.12)
}
.btn-ghost:hover{background:var(--champagne);border-color:var(--champagne);color:var(--ink)}
.btn-outline{border-color:rgba(98,36,36,.38);color:var(--velvet);background:transparent}

.preloader{position:fixed;inset:0;z-index:9999;background:var(--satin);display:grid;place-items:center;transition:opacity .7s,visibility .7s}
.preloader.hide{opacity:0;visibility:hidden}
.loader-stage{width:min(340px,76vw);text-align:center;position:relative}
.loader-orbit{width:180px;height:180px;margin:auto;position:relative;display:grid;place-items:center}
.loader-orbit:before,.loader-orbit:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(98,36,36,.19);inset:0;animation:orbit 3.4s ease-in-out infinite}
.loader-orbit:after{inset:20px;border-color:rgba(193,220,222,.95);animation-delay:-1.2s}
.loader-logo{width:120px;height:120px;object-fit:contain;position:relative;z-index:2;animation:breath 2.2s ease-in-out infinite}
.loader-line{height:1px;background:rgba(98,36,36,.14);margin:26px auto 12px;overflow:hidden;width:190px}
.loader-line:after{content:"";display:block;width:70px;height:100%;background:var(--velvet);animation:loadline 1.6s ease-in-out infinite}
.loader-copy{font-size:9px;letter-spacing:.28em;text-transform:uppercase;color:var(--velvet)}
@keyframes orbit{50%{transform:scale(1.08) rotate(12deg);opacity:.52}}
@keyframes breath{50%{transform:translateY(-4px);opacity:.82}}
@keyframes loadline{0%{transform:translateX(-80px)}100%{transform:translateX(210px)}}

.site-header{
  position:fixed;top:0;left:0;right:0;width:100%;z-index:2100;background:rgba(255,255,255,.985);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid rgba(98,36,36,.10);
  transform:none!important;opacity:1!important
}
.header-inner{
  height:88px;display:grid;grid-template-columns:170px minmax(0,1fr) auto auto;
  align-items:center;gap:22px
}
.brand-logo{width:128px;height:70px;object-fit:contain;object-position:left center;filter:drop-shadow(0 4px 12px rgba(98,36,36,.05))}
.nav{
  display:flex;align-items:center;justify-content:center;gap:clamp(18px,2.1vw,34px);
  min-width:0
}
.nav a{
  font-size:11px;font-weight:600;color:var(--ink);position:relative;
  white-space:nowrap;cursor:pointer;letter-spacing:.01em
}
.nav a:after{content:"";position:absolute;height:1px;background:var(--velvet);left:0;right:100%;bottom:-10px;transition:right .25s}
.nav a:hover,.nav a.active{color:var(--velvet)}
.nav a:hover:after,.nav a.active:after{right:0}
.book-cta{white-space:nowrap;margin-left:6px;box-shadow:0 7px 20px rgba(98,36,36,.13)}
.menu-toggle{
  display:none;width:42px;height:42px;border-radius:50%;
  border:1px solid rgba(98,36,36,.32);background:#fff;position:relative;
  cursor:pointer;z-index:2201;flex:0 0 auto
}
.menu-toggle span,.menu-toggle:before,.menu-toggle:after{
  content:"";position:absolute;left:12px;right:12px;height:1px;
  background:var(--velvet);transition:transform .28s ease,top .28s ease,opacity .22s ease
}
.menu-toggle:before{top:13px}.menu-toggle span{top:20px}.menu-toggle:after{top:27px}
.menu-toggle.open:before{top:20px;transform:rotate(45deg)}
.menu-toggle.open span{opacity:0}
.menu-toggle.open:after{top:20px;transform:rotate(-45deg)}

.mobile-menu{
  position:fixed;top:74px;left:0;right:0;bottom:0;background:rgba(242,241,235,.985);
  z-index:2050;padding:22px var(--pad) 34px;opacity:0;visibility:hidden;
  transform:translateY(-10px);transition:opacity .28s ease,transform .28s ease,visibility .28s;
  overflow-y:auto;overscroll-behavior:contain
}
.mobile-menu.open{opacity:1;visibility:visible;transform:none}
.mobile-menu:before{
  content:"";display:block;height:7px;margin:0 0 18px;
  background:repeating-linear-gradient(90deg,var(--velvet) 0 14px,var(--blue) 14px 28px);
  opacity:.86
}
.mobile-menu a{
  display:flex;justify-content:space-between;align-items:center;padding:17px 2px;
  border-bottom:1px solid rgba(98,36,36,.13);font-size:19px;
  font-family:"Cormorant Garamond",Georgia,serif;cursor:pointer
}
.mobile-menu a span:last-child{font-family:"Livvic",sans-serif;font-size:14px;color:var(--velvet)}
.mobile-menu .mobile-book{
  margin-top:24px;width:100%;font-family:"Livvic",sans-serif;font-size:10px;
  display:flex!important;justify-content:center!important;align-items:center!important;
  text-align:center!important;padding-left:18px!important;padding-right:18px!important
}

.page-view{display:none;opacity:0}
.page-view.active{display:block;animation:pageIn .45s ease both}
@keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.page-hero{position:relative;min-height:clamp(480px,67vh,720px);display:flex;align-items:end;overflow:hidden;background:#6c4a31}
.page-hero.short{min-height:420px}
.page-hero img{position:absolute;inset:0;height:100%;object-fit:cover}
.page-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,15,12,.08) 18%,rgba(20,15,12,.70))}
.page-hero-content{position:relative;z-index:2;color:#fff;padding:clamp(54px,7vw,96px) 0}
.page-hero h1{font-size:clamp(48px,6vw,88px);line-height:.94;max-width:860px;margin:12px 0 18px}
.page-hero p{max-width:650px;font-size:15px;line-height:1.75;color:rgba(255,255,255,.86);margin:0}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}

.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(34px,6vw,90px);align-items:center}
.intro-img{border-radius:26px;overflow:hidden;aspect-ratio:4/5;cursor:zoom-in}
.intro-img img{height:100%;object-fit:cover;transition:transform .8s}
.intro-img:hover img{transform:scale(1.025)}
.intro-copy h2{font-size:clamp(42px,5vw,72px);line-height:1;margin:14px 0 20px}
.intro-copy p{color:var(--muted);line-height:1.85;font-size:15px}
.signature{margin-top:30px;padding-top:24px;border-top:1px solid var(--line);font-family:"Cormorant Garamond",Georgia,serif;font-size:24px;font-style:italic;color:var(--velvet)}
.editorial-strip{background:var(--velvet);color:#fff}
.editorial-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}
.media-card{position:relative;border-radius:25px;overflow:hidden;min-height:560px;background:#3c302b;cursor:zoom-in}
.media-card img{height:100%;object-fit:cover;transition:transform .8s}
.media-card:hover img{transform:scale(1.03)}
.media-tag{position:absolute;left:18px;bottom:18px;background:rgba(30,26,25,.52);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.16);padding:14px 16px;border-radius:15px;color:#fff}
.media-tag b{display:block;font-family:"Cormorant Garamond",Georgia,serif;font-size:24px;font-weight:500}
.media-tag span{font-size:10px;letter-spacing:.13em;text-transform:uppercase;opacity:.78}
.fact-row{display:grid;grid-template-columns:repeat(4,1fr);margin-top:36px;border-top:1px solid rgba(255,255,255,.18)}
.fact{padding:24px 22px 0;border-right:1px solid rgba(255,255,255,.18)}
.fact:last-child{border-right:0}
.fact b{color:var(--blue);font-size:10px;letter-spacing:.16em}
.fact p{font-size:13px;line-height:1.55;margin:8px 0}

.hotel-gallery{display:grid;grid-template-columns:1.4fr .6fr;gap:12px;min-height:620px}
.hotel-gallery .g-main,.hotel-gallery .g-side{overflow:hidden;border-radius:22px;position:relative;cursor:zoom-in}
.hotel-gallery .g-side-wrap{display:grid;grid-template-rows:1fr 1fr;gap:12px}
.hotel-gallery img{height:100%;object-fit:cover;transition:transform .65s}
.hotel-gallery [data-gallery]:hover img{transform:scale(1.025)}
.gallery-flag{position:absolute;right:16px;bottom:16px;background:rgba(255,255,255,.94);color:var(--velvet);border-radius:999px;padding:11px 14px;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.amenity-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.amenity{background:#fff;border:1px solid rgba(98,36,36,.08);border-radius:18px;padding:22px;min-height:145px}
.amenity i{font-style:normal;color:var(--velvet);font-size:10px;letter-spacing:.15em}
.amenity h3{font-family:"Cormorant Garamond",Georgia,serif;font-size:25px;font-weight:500;margin:22px 0 8px}
.amenity p{margin:0;color:var(--muted);font-size:13px;line-height:1.65}
.facility-list{display:grid;gap:18px}
.facility-row{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,6vw,90px);align-items:center;padding:34px 0;border-top:1px solid var(--line)}
.facility-row:nth-child(even) .facility-photo{order:2}
.facility-photo{aspect-ratio:4/3;border-radius:24px;overflow:hidden;cursor:zoom-in;position:relative}
.facility-photo img{height:100%;object-fit:cover;transition:transform .7s}
.facility-photo:hover img{transform:scale(1.035)}
.facility-copy h3{font-size:clamp(34px,4vw,55px);margin:8px 0 14px}
.facility-copy p{font-size:14px;color:var(--muted);line-height:1.8}

.location-intro{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;align-items:start}
.location-intro h2{font-size:clamp(42px,5vw,72px);line-height:1;margin:10px 0}
.location-intro p{font-size:15px;line-height:1.8;color:var(--muted)}
.place-tabs-wrap{
  position:relative;margin:34px 0 26px;width:100%;max-width:100%;
  overflow:hidden;border-top:1px solid rgba(98,36,36,.18);
  border-bottom:1px solid rgba(98,36,36,.18);
  background:rgba(255,255,255,.56)
}
.place-tabs-wrap:after{
  content:"";position:absolute;right:0;top:0;bottom:0;width:38px;pointer-events:none;
  background:linear-gradient(90deg,rgba(242,241,235,0),rgba(242,241,235,.95))
}
.place-tabs{
  display:flex;gap:0;margin:0;width:100%;max-width:100%;
  overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;
  -webkit-overflow-scrolling:touch;touch-action:pan-x;
  scrollbar-width:none;scroll-snap-type:x proximity
}
.place-tabs::-webkit-scrollbar{display:none}
.place-tab{
  position:relative;flex:1 0 150px;min-width:150px;border:0;
  border-right:1px solid rgba(98,36,36,.12);background:transparent;border-radius:0;
  padding:14px 14px 13px;text-align:left;cursor:pointer;color:var(--ink);
  transition:background .25s,color .25s;scroll-snap-align:start
}
.place-tab:last-child{border-right:0}
.place-tab .cat-top{display:flex;align-items:center;gap:9px}
.place-tab .cat-no{
  font-family:"Cormorant Garamond",Georgia,serif;font-size:15px;color:var(--velvet);
  min-width:18px
}
.place-tab .cat-icon{
  width:30px;height:30px;border-radius:9px;border:1px solid rgba(98,36,36,.17);
  display:grid;place-items:center;background:rgba(255,255,255,.6);color:var(--velvet);
  transition:.25s
}
.place-tab .cat-icon svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.place-tab .cat-label{
  display:block;margin-top:7px;font-size:9px;letter-spacing:.13em;
  text-transform:uppercase;font-weight:700;white-space:nowrap
}
.place-tab:after{
  content:"";position:absolute;left:14px;right:14px;bottom:-1px;height:2px;
  background:var(--velvet);transform:scaleX(0);transform-origin:left;transition:transform .25s
}
.place-tab:hover{background:rgba(193,220,222,.2);color:var(--velvet)}
.place-tab.active{background:var(--velvet);color:#fff}
.place-tab.active .cat-no{color:var(--champagne)}
.place-tab.active .cat-icon{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.24);color:#fff}
.place-tab.active:after{transform:scaleX(1);background:var(--champagne)}
.map-shell{display:grid;grid-template-columns:1.2fr .8fr;min-height:600px;background:#fff;border-radius:26px;overflow:hidden;box-shadow:var(--shadow)}
.map-panel{position:relative;background:linear-gradient(135deg,#d6e5e5,#f2f1eb 62%,#d7caba);overflow:hidden}
.map-grid-lines{position:absolute;inset:-30%;opacity:.28;background-image:linear-gradient(rgba(98,36,36,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(98,36,36,.14) 1px,transparent 1px);background-size:52px 52px;transform:rotate(-12deg)}
.map-road{position:absolute;height:16px;background:rgba(255,255,255,.78);border:1px solid rgba(98,36,36,.08);border-radius:999px;transform-origin:left center}
.road1{width:80%;left:5%;top:50%;transform:rotate(-17deg)}.road2{width:65%;left:24%;top:23%;transform:rotate(38deg)}.road3{width:70%;left:12%;top:74%;transform:rotate(10deg)}
.map-pin{position:absolute;transform:translate(-50%,-50%);border:0;background:none;cursor:pointer;text-align:center}
.map-pin-dot{width:34px;height:34px;border-radius:50%;background:#fff;border:1px solid rgba(98,36,36,.3);display:grid;place-items:center;margin:auto;box-shadow:0 7px 20px rgba(30,26,25,.14);font-size:14px}
.map-pin.home .map-pin-dot{width:50px;height:50px;background:var(--velvet);color:#fff}
.map-pin-label{display:block;background:rgba(255,255,255,.92);padding:5px 8px;border-radius:8px;margin-top:5px;font-size:9px;font-weight:700;white-space:nowrap}
.map-pin.hidden{display:none}

.map-pin-dot{transition:transform .25s,box-shadow .25s,background .25s}
.map-pin-dot svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.map-pin:hover .map-pin-dot{transform:translateY(-3px);box-shadow:0 10px 24px rgba(30,26,25,.18)}
.map-pin.home .map-pin-dot svg{width:20px;height:20px}
.map-pin-label{box-shadow:0 5px 16px rgba(30,26,25,.06)}

.place-list{padding:28px;max-height:600px;overflow:auto}
.place-list h3{font-size:30px;margin:4px 0 6px}
.place-list>p{color:var(--muted);font-size:13px;line-height:1.6;margin:0 0 20px}
.place-card{display:grid;grid-template-columns:56px 1fr auto;gap:13px;align-items:center;padding:16px 0;border-top:1px solid var(--line)}
.place-card .minutes{width:54px;height:54px;border-radius:50%;background:var(--satin);display:grid;place-items:center;text-align:center;color:var(--velvet);font-size:10px;font-weight:700;line-height:1.1}
.place-card strong{display:block;font-size:13px}
.place-card span{display:block;color:var(--muted);font-size:11px;margin-top:4px}
.place-card em{font-style:normal;font-size:17px;color:var(--velvet)}
.map-note{font-size:11px;color:var(--muted);line-height:1.6;margin-top:14px}
.map-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}

.policy-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.policy-card{background:#fff;border-radius:22px;padding:28px;border:1px solid rgba(98,36,36,.08)}
.policy-card b{font-size:10px;letter-spacing:.15em;color:var(--velvet)}
.policy-card h3{font-size:30px;margin:20px 0 10px}
.policy-card p{font-size:13px;line-height:1.75;color:var(--muted)}

.faq-layout{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(42px,7vw,100px)}
.faq-aside{position:sticky;top:125px;align-self:start}
.faq-aside h2{font-size:clamp(42px,5vw,70px);line-height:1;margin:10px 0 18px}
.faq-list{border-top:1px solid var(--line)}
.faq-item{border-bottom:1px solid var(--line)}
.faq-q{width:100%;border:0;background:none;display:grid;grid-template-columns:1fr auto;gap:20px;text-align:left;padding:22px 0;cursor:pointer;font-weight:600;font-size:14px}
.faq-q i{font-style:normal;width:30px;height:30px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;transition:.25s}
.faq-item.open .faq-q i{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s}
.faq-a p{margin:0;padding:0 55px 22px 0;color:var(--muted);font-size:13px;line-height:1.75}

.booking-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(35px,6vw,90px);align-items:start}
.booking-copy h2{font-size:clamp(42px,5vw,70px);line-height:1;margin:10px 0 18px}
.booking-copy p{font-size:14px;color:var(--muted);line-height:1.8}
.booking-card{background:#fff;padding:clamp(24px,4vw,42px);border-radius:26px;box-shadow:var(--shadow)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{display:flex;flex-direction:column;gap:7px}
.field.full{grid-column:1/-1}
.field label{font-size:9px;text-transform:uppercase;letter-spacing:.14em;color:var(--velvet);font-weight:700}
.field input,.field select,.field textarea{border:1px solid var(--line);border-radius:13px;padding:13px 14px;background:var(--satin);outline:none;color:var(--ink);font-size:13px}
.field textarea{min-height:100px;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--velvet);background:#fff}
.booking-card .btn{width:100%;margin-top:16px}

.lightbox{position:fixed;inset:0;background:rgba(17,14,13,.94);z-index:3000;display:grid;grid-template-columns:70px 1fr 70px;align-items:center;opacity:0;visibility:hidden;transition:.25s}
.lightbox.open{opacity:1;visibility:visible}
.lightbox-stage{height:86vh;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px}
.lightbox-img{max-width:100%;width:auto;max-height:78vh;object-fit:contain}
.lightbox-caption{color:rgba(255,255,255,.72);font-size:11px;letter-spacing:.08em}
.lb-btn{width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.07);color:#fff;display:grid;place-items:center;margin:auto;cursor:pointer;font-size:20px}
.lb-close{position:absolute;right:24px;top:24px}
.lb-count{position:absolute;left:25px;top:28px;color:#fff;font-size:10px;letter-spacing:.15em}

.final-cta{background:var(--blue);text-align:center;padding:clamp(75px,9vw,120px) 0}
.final-cta h2{font-size:clamp(44px,5.5vw,78px);line-height:.98;max-width:850px;margin:10px auto 20px}
.final-cta p{font-size:14px;line-height:1.75;color:#4f5b5b;max-width:610px;margin:0 auto 24px}
footer{background:var(--ink);color:#fff;padding:52px 0 24px}
.footer-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:50px;padding-bottom:42px}
.footer-logo{width:158px;height:auto;background:transparent;border-radius:0;padding:0;object-fit:contain}
footer p,footer a{color:rgba(255,255,255,.65);font-size:12px;line-height:1.7;display:block}
