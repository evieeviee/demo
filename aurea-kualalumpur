/* details considered */
.detail-mosaic{
  display:grid;grid-template-columns:1.2fr .8fr .8fr;grid-template-rows:300px 260px;gap:10px
}
.detail-mosaic .tile{position:relative;overflow:hidden;cursor:zoom-in}
.detail-mosaic .tile:first-child{grid-row:1/3}
.detail-mosaic .tile:nth-child(4){grid-column:2/4}
.detail-mosaic img{height:100%;object-fit:cover;transition:transform .8s}
.detail-mosaic .tile:hover img{transform:scale(1.04)}
.detail-caption{
  position:absolute;left:12px;bottom:12px;background:rgba(242,241,235,.93);
  color:var(--velvet);padding:8px 10px;font-size:8px;letter-spacing:.14em;text-transform:uppercase
}

/* Suite lookbook */
.lookbook-nav{
