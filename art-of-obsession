/* ===== V2 PRE-ORDERS + STORY MERGE ===== */
.v2-preorder-wrap{padding:0 0 88px}
.v2-inner-hero{
  padding:72px 0 52px;
  display:grid;
  grid-template-columns:1fr .8fr;
  gap:40px;
  align-items:end;
}
.v2-inner-hero h1{
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(56px,7vw,88px);
  line-height:.92;
  font-weight:500;
  letter-spacing:-.03em;
  color:var(--brown);
}
.v2-inner-hero p{
  max-width:520px;
  color:var(--muted);
  margin-left:auto;
  padding-bottom:8px;
  line-height:1.75;
}
.v2-eyebrow{
  display:inline-flex;
  align-items:center;
  gap:10px;
  color:var(--brown2);
  font-size:9px;
  font-weight:800;
  letter-spacing:.18em;
  text-transform:uppercase;
  margin-bottom:12px;
}
.v2-eyebrow:before,.v2-eyebrow:after{
  content:"";
  width:28px;
  height:1px;
  background:var(--rose);
}

.v2-occasion-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}
.v2-occasion{
  min-height:280px;
  border-radius:24px;
  padding:24px;
  background:linear-gradient(160deg,#fffdf9,#eee0d4);
  border:1px solid var(--line);
  position:relative;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
}
.v2-occasion:nth-child(even){
  background:linear-gradient(160deg,#f1dfd7,#fffaf5);
}
.v2-occasion-num{
  position:absolute;
  right:17px;
  top:2px;
  font-family:"Cormorant Garamond",serif;
  font-size:72px;
  color:rgba(74,47,40,.08);
}
.v2-occasion h3{
  font-family:"Cormorant Garamond",serif;
  font-size:28px;
  font-weight:500;
  line-height:1.05;
}
.v2-occasion p{
  color:var(--muted);
  font-size:10px;
  line-height:1.55;
  margin-top:7px;
}

.v2-process{
  margin-top:70px;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
  border-radius:28px;
  overflow:hidden;
}
.v2-process-step{
  background:#fff;
  padding:28px;
  min-height:210px;
}
.v2-process-step strong{
  display:block;
  color:var(--rose);
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.15em;
  margin-bottom:28px;
}
.v2-process-step h3{
  font-family:"Cormorant Garamond",serif;
  font-size:27px;
  font-weight:500;
  margin-bottom:10px;
}
.v2-process-step p{
  color:var(--muted);
  font-size:10px;
  line-height:1.65;
}
.v2-preorder-strip{
  margin-top:54px;
  background:var(--cocoa);
  color:#fff;
  border-radius:30px;
  padding:48px;
  display:grid;
  grid-template-columns:1fr auto;
  align-items:center;
  gap:28px;
  overflow:hidden;
  position:relative;
}
.v2-preorder-strip:after{
  content:"The Art of Obsession";
  position:absolute;
  right:-20px;
  bottom:-34px;
  font-family:"Cormorant Garamond",serif;
  font-style:italic;
  font-size:76px;
  color:rgba(255,255,255,.045);
  white-space:nowrap;
}
.v2-preorder-strip h3{
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(38px,4vw,54px);
  font-weight:500;
  line-height:1;
}
.v2-preorder-strip p{
  color:#d9cbc4;
  margin-top:9px;
  max-width:720px;
  font-size:11px;
  line-height:1.65;
}
.v2-preorder-strip .btn{position:relative;z-index:2;background:var(--cream2)}

.v2-story-section{padding:80px 0}
.v2-story-layout{
  display:grid;
  grid-template-columns:.85fr 1.15fr;
  gap:64px;
  align-items:center;
}
.v2-story-collage{
  position:relative;
  min-height:690px;
}
.v2-story-collage .a{
  width:76%;
  height:580px;
  object-fit:cover;
  border-radius:190px 190px 28px 28px;
}
.v2-story-collage .b{
  position:absolute;
  right:0;
  bottom:0;
  width:43%;
  height:310px;
  object-fit:cover;
  border:10px solid var(--cream2);
  border-radius:120px 120px 18px 18px;
}
.v2-story-copy h2{
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(48px,6vw,72px);
  line-height:.93;
  font-weight:500;
  letter-spacing:-.03em;
  color:var(--brown);
  margin:12px 0 22px;
}
.v2-story-copy p{
  color:var(--muted);
  font-size:12px;
  line-height:1.75;
  margin-bottom:14px;
}
.v2-story-quote{
  margin:28px 0;
  padding:24px 0 24px 26px;
  border-left:2px solid var(--rose);
  font-family:"Cormorant Garamond",serif;
  font-size:28px;
  line-height:1.25;
  color:var(--brown);
}
.v2-story-philosophy{
  padding:82px 0 24px;
}
.v2-editorial-grid{
  display:grid;
  grid-template-columns:1.2fr .8fr .8fr;
  gap:18px;
}
.v2-editorial-card{
  min-height:420px;
  position:relative;
  overflow:hidden;
  border-radius:26px;
  background:#ddd;
  box-shadow:var(--shadow);
  isolation:isolate;
}
.v2-editorial-card.tall{min-height:560px}
.v2-editorial-card img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  z-index:-2;
  transition:transform .65s var(--ease);
}
.v2-editorial-card:after{
  content:"";
  position:absolute;
  inset:0;
  z-index:-1;
  background:linear-gradient(180deg,transparent 35%,rgba(30,20,17,.82));
}
.v2-editorial-card:hover img{transform:scale(1.045)}
.v2-editorial-info{
  position:absolute;
  left:24px;
  right:24px;
  bottom:24px;
  color:#fff;
}
.v2-editorial-info small{
  text-transform:uppercase;
  letter-spacing:.14em;
  font-size:8px;
  font-weight:800;
  opacity:.82;
}
.v2-editorial-info h3{
  font-family:"Cormorant Garamond",serif;
  font-size:32px;
  line-height:1.02;
  font-weight:500;
  margin-top:6px;
}

@media(max-width:980px){
  .v2-occasion-grid{grid-template-columns:1fr 1fr}
  .v2-process{grid-template-columns:1fr 1fr}
  .v2-story-layout{grid-template-columns:1fr;gap:36px}
  .v2-editorial-grid{grid-template-columns:1fr 1fr}
