  if(name==="product"&&current)lastBrowseView=current;
  document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
  target.classList.add("active");
  closeMobileMenu();
  window.scrollTo({top:0,behavior:"smooth"});
  if(name==="shop"){renderShop();syncFilterUI()}
  if(name==="checkout")renderCheckout();
  if(name==="home")setTimeout(startBestAuto,700);else stopBestAuto();
  setTimeout(initReveal,20);
}
function goBackView(){
  const previous=viewHistory.pop()||"home";
  showView(previous,false);
}
function toggleMobileMenu(){const m=document.getElementById("mobileMenu");m.classList.toggle("active");document.body.classList.toggle("menu-open",m.classList.contains("active"))}function closeMobileMenu(){document.getElementById("mobileMenu").classList.remove("active");document.body.classList.remove("menu-open")}function mobileNavigate(name){showView(name)}
function productCard(p){return `<article class="product-card" onclick="openProduct('${p.id}')"><img src="${p.image}" alt="${p.name}"><div class="product-body"><span class="pill">${p.category.includes("rare")?"Rare Classic":p.category.includes("pastry")?"Pastry":"Signature"}</span><h3>${p.name}</h3><p>${p.desc}</p><div class="price">${p.priceLabel}</div></div></article>`}
function bestSellerCard(p,index){const imgs=(p.images?.length?p.images:[p.image]).slice(0,3);return `<article class="best-card" onclick="openProduct('${p.id}')" onmouseenter="startBestHover(this)" onmouseleave="stopBestHover(this)"><div class="best-image"><div class="best-track" data-index="0">${imgs.map((img,i)=>`<img src="${img}" alt="${p.name} view ${i+1}" loading="${index>1?'lazy':'eager'}">`).join("")}</div><span class="best-badge">${index===0?'Best Seller':'Customer Favourite'}</span><div class="best-dots">${imgs.map((_,i)=>`<i class="best-dot ${i===0?'active':''}"></i>`).join("")}</div></div><div class="product-body"><h3>${p.name}</h3><div class="price">${p.priceLabel}</div></div></article>`}
function renderHome(){document.getElementById("homeProducts").innerHTML=PRODUCTS.slice(0,6).map(bestSellerCard).join("");setTimeout(renderBestPagination,0)}
function renderShop(){const filtered=activeFilter==="all"?PRODUCTS:PRODUCTS.filter(p=>p.category.includes(activeFilter));document.getElementById("shopProducts").innerHTML=filtered.map(productCard).join("")}
function syncFilterUI(){document.querySelectorAll("#shopView .filter").forEach(b=>b.classList.toggle("active",b.dataset.filter===activeFilter))}
function filterProducts(filter,btn){activeFilter=filter;syncFilterUI();renderShop()}
function shopCategory(category){activeFilter=category;showView("shop");syncFilterUI();renderShop()}
function toggleMobileGroup(id){const group=document.getElementById(id);group.classList.toggle("open");const sign=group.querySelector(".mobile-group-head span");if(sign)sign.textContent=group.classList.contains("open")?'−':'+'}
function startBestHover(card){if(matchMedia('(hover: none)').matches)return;stopBestHover(card,false);const track=card.querySelector('.best-track'),dots=[...card.querySelectorAll('.best-dot')],count=track.children.length;if(count<2)return;card._bestTimer=setInterval(()=>{let i=(Number(track.dataset.index||0)+1)%count;track.dataset.index=i;track.style.transform=`translateX(-${i*100}%)`;dots.forEach((d,n)=>d.classList.toggle('active',n===i))},850)}
function stopBestHover(card,reset=true){if(card._bestTimer)clearInterval(card._bestTimer);card._bestTimer=null;if(reset){const track=card.querySelector('.best-track'),dots=[...card.querySelectorAll('.best-dot')];if(track){track.dataset.index=0;track.style.transform='translateX(0)'}dots.forEach((d,n)=>d.classList.toggle('active',n===0))}}
function scrollBest(dir){const row=document.getElementById('homeProducts');row?.scrollBy({left:dir*Math.min(row.clientWidth*.8,360),behavior:'smooth'});pauseBestAuto()}
function openProduct(id){currentProduct=PRODUCTS.find(p=>p.id===id);if(!currentProduct)return;currentVariant=currentProduct.variants[0];currentSize=currentProduct.sizes[0];currentQty=1;currentGalleryIndex=0;renderGallery();document.getElementById("productName").textContent=currentProduct.name;document.getElementById("productDesc").textContent=currentProduct.desc;document.getElementById("qty").textContent=currentQty;document.getElementById("variantOptions").innerHTML=currentProduct.variants.map((v,i)=>`<button class="option-btn ${i===0?"active":""}" onclick="selectVariant('${v}',this)">${v}</button>`).join("");document.getElementById("sizeOptions").innerHTML=currentProduct.sizes.map((s,i)=>`<button class="option-btn ${i===0?"active":""}" onclick="selectSize('${s}',this)">${s}</button>`).join("");updateProductPrice();showView("product")}
function currentPrice(){let price=currentProduct.base;if(currentVariant==="Alcohol")price+=currentProduct.alcohol||0;if(currentSize==="8 inch")price+=currentProduct.size8||0;if(currentSize==="Box of 6")price+=10;if(currentSize==="Large")price+=8;return price}function updateProductPrice(){document.getElementById("productPrice").textContent="RM"+currentPrice().toFixed(2)}function selectVariant(v,btn){currentVariant=v;document.querySelectorAll("#variantOptions .option-btn").forEach(x=>x.classList.remove("active"));btn.classList.add("active");updateProductPrice()}function selectSize(s,btn){currentSize=s;document.querySelectorAll("#sizeOptions .option-btn").forEach(x=>x.classList.remove("active"));btn.classList.add("active");updateProductPrice()}function changeQty(n){currentQty=Math.max(1,currentQty+n);document.getElementById("qty").textContent=currentQty}function addCurrentProduct(){addToCart({id:currentProduct.id,name:currentProduct.name,image:currentProduct.image,variant:currentVariant,size:currentSize,price:currentPrice(),qty:currentQty})}
function getCart(){try{return JSON.parse(localStorage.getItem("taoo-demo-cart")||"[]")}catch(e){return[]}}function setCart(cart){localStorage.setItem("taoo-demo-cart",JSON.stringify(cart));renderCart()}function addToCart(item){const cart=getCart();const key=[item.id,item.variant,item.size].join("|");const found=cart.find(x=>x.key===key);if(found)found.qty+=item.qty;else cart.push({...item,key});setCart(cart);openCart()}function removeCart(key){setCart(getCart().filter(x=>x.key!==key))}
function renderCart(){const cart=getCart(),count=cart.reduce((a,b)=>a+b.qty,0);document.querySelectorAll("[data-cart-count]").forEach(x=>x.textContent=count);const box=document.getElementById("cartItems");if(!cart.length){box.innerHTML='<div style="padding:30px 0;color:var(--muted)">Your cart is empty.</div>';document.getElementById("cartTotal").textContent="RM0.00";return}box.innerHTML=cart.map(x=>`<div class="cart-item"><img src="${x.image}"><div><h4>${x.name}</h4><p>${x.variant}${x.size?" · "+x.size:""} · Qty ${x.qty}</p><p>RM${(x.price*x.qty).toFixed(2)}</p></div><button class="cart-remove" onclick="removeCart('${x.key}')">Remove</button></div>`).join("");document.getElementById("cartTotal").textContent="RM"+cart.reduce((a,b)=>a+b.price*b.qty,0).toFixed(2)}function openCart(){document.getElementById("cartDrawer").classList.add("open");document.body.classList.add("cart-open");renderCart()}function closeCart(){document.getElementById("cartDrawer").classList.remove("open");document.body.classList.remove("cart-open")}function goCheckout(){closeCart();showView("checkout")}
function renderCheckout(){const cart=getCart(),box=document.getElementById("checkoutItems");if(!cart.length){box.innerHTML='<p class="notice">Your cart is empty.</p>';document.getElementById("checkoutTotal").textContent="RM0.00";return}box.innerHTML=cart.map(x=>`<div class="order-line"><img src="${x.image}"><div><h4>${x.name}</h4><p>${x.variant}${x.size?" · "+x.size:""} · Qty ${x.qty}</p></div><strong>RM${(x.price*x.qty).toFixed(2)}</strong></div>`).join("");document.getElementById("checkoutTotal").textContent="RM"+cart.reduce((a,b)=>a+b.price*b.qty,0).toFixed(2)}
function submitWhatsApp(){const cart=getCart();if(!cart.length)return alert("Your cart is empty.");if(!document.getElementById("paid").checked)return alert("Please confirm payment first.");const order="TAO-"+new Date().toISOString().slice(2,10).replaceAll("-","")+"-"+Math.floor(1000+Math.random()*9000);const items=cart.map((x,i)=>`${i+1}. ${x.name} - ${x.variant}${x.size?" / "+x.size:""} x${x.qty} - RM${(x.price*x.qty).toFixed(2)}`).join("\n");const total=cart.reduce((a,b)=>a+b.price*b.qty,0).toFixed(2);const msg=`Hi The Art of Obsession, I have completed payment and would like to submit my order.\n\nOrder: ${order}\n\n${items}\n\nTotal: RM${total}\n\nCustomer: ${document.getElementById("firstName").value} ${document.getElementById("lastName").value}\nPhone: ${document.getElementById("phone").value}\nFulfilment: ${document.getElementById("fulfilment").value}\nDate: ${document.getElementById("date").value}\nTime: ${document.getElementById("time").value}\nAddress / Pickup Notes: ${document.getElementById("address").value}\nOrder Notes: ${document.getElementById("notes").value}\n\nI will attach my bank transfer receipt in WhatsApp.`;window.open("https://wa.me/60168083598?text="+encodeURIComponent(msg),"_blank")}


let lastBrowseView="home",bestAutoTimer=null,bestResumeTimer=null;
function goBackFromProduct(){goBackView()}
function waOpen(message){window.open("https://wa.me/60168083598?text="+encodeURIComponent(message),"_blank")}
function sendPresetEnquiry(kind,item){const intro=kind==="masterclass"?"I’m interested in a masterclass.":"I’d like to enquire about a celebration / custom order.";const msg=`Hi The Art of Obsession, ${intro}\n\nEnquiry: ${item}\nPreferred date: \nNumber of guests / quantity: \nBudget (if any): \nNotes / design / flavour request: \n\nPlease let me know the availability, options and next steps.`;waOpen(msg)}
function submitCustomEnquiry(){const name=document.getElementById('enquiryName').value.trim(),phone=document.getElementById('enquiryPhone').value.trim(),type=document.getElementById('enquiryType').value,date=document.getElementById('enquiryDate').value||'Not specified',budget=document.getElementById('enquiryBudget').value||'Not sure yet',details=document.getElementById('enquiryDetails').value.trim(),notes=document.getElementById('enquiryNotes').value.trim();if(!details)return alert('Please tell us briefly what you would like.');const msg=`Hi The Art of Obsession, I’d like to make a custom enquiry.\n\nName: ${name||'Not provided'}\nPhone: ${phone||'Not provided'}\nEnquiry type: ${type}\nPreferred date: ${date}\nEstimated budget: ${budget}\n\nWhat I’m looking for:\n${details}\n\nDietary / flavour notes: ${notes||'None specified'}\n\nPlease let me know what is possible and the next steps.`;waOpen(msg)}
function startBestAuto(){stopBestAuto();if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;bestAutoTimer=setInterval(()=>{const row=document.getElementById('homeProducts');if(!row||!document.getElementById('homeView')?.classList.contains('active'))return;const cards=[...row.children];if(cards.length<2)return;const step=(cards[0]?.getBoundingClientRect().width||280)+16;const atEnd=row.scrollLeft+row.clientWidth>=row.scrollWidth-step*.65;if(atEnd){row.scrollTo({left:0,behavior:'smooth'})}else{row.scrollBy({left:step,behavior:'smooth'})}setTimeout(syncBestPagination,450)},3800)}
function stopBestAuto(){if(bestAutoTimer)clearInterval(bestAutoTimer);bestAutoTimer=null}
function pauseBestAuto(){stopBestAuto();clearTimeout(bestResumeTimer);bestResumeTimer=setTimeout(startBestAuto,6500)}

function renderGallery(){const imgs=currentProduct.images?.length?currentProduct.images:[currentProduct.image];const main=document.getElementById("productImage"),thumbs=document.getElementById("galleryThumbs"),count=document.getElementById("galleryCount");main.src=imgs[currentGalleryIndex];main.alt=currentProduct.name+" view "+(currentGalleryIndex+1);count.textContent=(currentGalleryIndex+1)+" / "+imgs.length;thumbs.innerHTML=imgs.map((img,i)=>`<button class="gallery-thumb ${i===currentGalleryIndex?"active":""}" onclick="setGalleryImage(${i})" aria-label="View ${i+1}"><img src="${img}" alt="${currentProduct.name} thumbnail ${i+1}"></button>`).join("")}
function setGalleryImage(i){if(!currentProduct||i===currentGalleryIndex)return;const wrap=document.getElementById("productMainWrap");wrap.classList.add("switching");setTimeout(()=>{currentGalleryIndex=i;renderGallery();wrap.classList.remove("switching")},140)}

async function copyBankAccount(){const raw=document.getElementById('bankAccount')?.textContent||'';const value=raw.replace(/\s/g,'');try{await navigator.clipboard.writeText(value)}catch(e){const t=document.createElement('textarea');t.value=value;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove()}const btn=document.getElementById('copyBankBtn'),toast=document.getElementById('toast');if(btn){btn.textContent='Copied ✓';btn.classList.add('copied');setTimeout(()=>{btn.textContent='Copy Account';btn.classList.remove('copied')},1800)}if(toast){toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1800)}}


function initReveal(){
  const els=document.querySelectorAll('.section-head,.product-card,.master-card,.story-teaser,.editorial-band,.v2-occasion,.v2-process,.v2-story-layout,.v2-editorial-card');
  els.forEach(el=>el.classList.add('reveal'));
  if(!('IntersectionObserver' in window)){els.forEach(el=>el.classList.add('in'));return}
  const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.1});els.forEach(el=>io.observe(el));
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeCart();closeMobileMenu()}});

function updateChrome(){document.querySelector(".header")?.classList.toggle("scrolled",scrollY>18);const max=document.documentElement.scrollHeight-innerHeight;document.getElementById("progressLine").style.width=(max>0?(scrollY/max)*100:0)+"%"}
window.addEventListener("scroll",updateChrome,{passive:true});


function renderBestPagination(){
  const row=document.getElementById("homeProducts");
  const pagination=document.getElementById("bestPagination");
  if(!row||!pagination)return;

  const cards=[...row.children];
  pagination.innerHTML=cards.map((_,i)=>`
    <button class="best-page-dot ${i===0?'active':''}"
      type="button"
      aria-label="Go to best seller ${i+1}"
      aria-current="${i===0?'true':'false'}"
      onclick="goToBestSeller(${i})"></button>
  `).join("");

  syncBestPagination();
}

function bestSellerStep(){
  const row=document.getElementById("homeProducts");
  const first=row?.children?.[0];
  if(!row||!first)return 1;
  const styles=getComputedStyle(row);
  const gap=parseFloat(styles.columnGap||styles.gap||"16")||16;
  return first.getBoundingClientRect().width+gap;
}

function syncBestPagination(){
  const row=document.getElementById("homeProducts");
  const dots=[...document.querySelectorAll("#bestPagination .best-page-dot")];
  if(!row||!dots.length)return;

  const step=bestSellerStep();
  let index=Math.round(row.scrollLeft/step);
  index=Math.max(0,Math.min(dots.length-1,index));

  dots.forEach((dot,i)=>{
    const active=i===index;
    dot.classList.toggle("active",active);
    dot.setAttribute("aria-current",active?"true":"false");
  });
}

function goToBestSeller(index){
  const row=document.getElementById("homeProducts");
  if(!row)return;
  row.scrollTo({left:index*bestSellerStep(),behavior:"smooth"});
  pauseBestAuto();
}

document.addEventListener("DOMContentLoaded",()=>{
  renderHome();
  renderShop();
  renderCart();
  initReveal();
  updateChrome();
  startBestAuto();

  const row=document.getElementById("homeProducts");
  ["pointerdown","touchstart","wheel"].forEach(ev=>row?.addEventListener(ev,pauseBestAuto,{passive:true}));
  row?.addEventListener("scroll",syncBestPagination,{passive:true});
  window.addEventListener("resize",syncBestPagination,{passive:true});
  setTimeout(renderBestPagination,80);
});

window.addEventListener("resize",()=>{
  if(window.scrollX!==0) window.scrollTo({left:0,top:window.scrollY,behavior:"auto"});
},{passive:true});
window.addEventListener("orientationchange",()=>{
  setTimeout(()=>window.scrollTo({left:0,top:window.scrollY,behavior:"auto"}),120);
},{passive:true});

</script>
