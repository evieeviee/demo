  .v2-inner-hero p{margin:14px 0 0;padding:0;font-size:12px}
  .v2-occasion-grid{grid-template-columns:1fr 1fr;gap:10px}
  .v2-occasion{min-height:205px;padding:18px}
  .v2-occasion-num{font-size:58px}
  .v2-occasion h3{font-size:23px}
  .v2-process{grid-template-columns:1fr;margin-top:44px}
