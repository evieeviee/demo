  <style>
    :root {
      --light-bg: #fbfbf9;
      --scandi-beige: #e7dfd2;
      --sage: #617067;
      --sage-dark: #445149;
      --charcoal: #1e2220;
      --white: #ffffff;
      --muted: #606761;
      --line: #cfc5b7;
      --yellow: #f2d879;
      --wa-green: #25d366;
      --shadow: 0 24px 70px rgba(30, 34, 32, 0.12);
      --sans: "DM Sans", sans-serif;
      --display: "Space Grotesk", sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 95px;
    }

    body {
      background:
        radial-gradient(circle at 95% 4%, rgba(242, 216, 121, 0.17), transparent 24%),
        var(--light-bg);
      color: var(--charcoal);
      font-family: var(--sans);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    img {
      display: block;
      width: 100%;
      object-fit: cover;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    h1,
    h2,
    h3,
    .logo {
      font-family: var(--display);
    }

    .container {
      width: min(1200px, calc(100% - 32px));
      margin: 0 auto;
    }

    .announcement {
      padding: 10px 16px;
      background: var(--charcoal);
      color: rgba(255, 255, 255, 0.78);
      text-align: center;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .announcement strong {
      color: var(--yellow);
    }

    header {
      position: sticky;
      top: 0;
      z-index: 50;
      border-bottom: 2px solid var(--charcoal);
      background: rgba(251, 251, 249, 0.92);
      backdrop-filter: blur(14px);
    }

    .nav-container {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .logo {
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.06em;
    }

    .logo span {
      color: var(--sage);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.85rem;
      font-weight: 700;
      transition: 0.25s ease;
    }

    .nav-links a:hover {
      color: var(--sage);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .social-icons {
      display: flex;
      gap: 8px;
    }

    .social-icons a {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border: 2px solid var(--charcoal);
      border-radius: 8px;
      background: white;
      transition: 0.25s ease;
    }

    .social-icons a:hover {
      background: var(--charcoal);
      color: white;
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      width: 44px;
      height: 44px;
      border: 2px solid var(--charcoal);
      border-radius: 8px;
      background: white;
    }

    .mobile-menu {
      display: none;
      padding: 10px 0 20px;
      border-top: 1px solid var(--line);
    }

    .mobile-menu.open {
      display: grid;
      gap: 8px;
    }

    .mobile-menu a {
      padding: 12px 2px;
      border-bottom: 1px solid var(--line);
      font-weight: 700;
    }

    .hero {
      padding: 76px 0 92px;
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 0.92fr 1.08fr;
      gap: 50px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--sage-dark);
      font-size: 0.67rem;
      font-weight: 800;
      letter-spacing: 0.17em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 34px;
      height: 2px;
      background: var(--charcoal);
    }

    .hero-copy h1 {
      max-width: 680px;
      margin: 18px 0 22px;
      font-size: clamp(3.45rem, 7vw, 5.8rem);
      line-height: 0.98;
      letter-spacing: -0.06em;
    }

    .hero-copy p {
      max-width: 590px;
      color: var(--muted);
      font-size: 1.04rem;
      line-height: 1.85;
    }

    .button-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 30px;
    }

    .action-btn {
      min-height: 50px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 24px;
      border: 2px solid var(--charcoal);
      font-size: 0.88rem;
      font-weight: 800;
      transition: 0.25s ease;
    }

    .btn-dark {
      background: var(--charcoal);
      color: var(--white);
      box-shadow: 5px 5px 0 var(--scandi-beige);
    }

    .btn-dark:hover {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0 var(--scandi-beige);
    }

    .btn-plain {
      background: transparent;
    }

    .btn-plain:hover {
      background: var(--scandi-beige);
      transform: translateY(-2px);
    }

    .hero-points {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    .hero-point {
      padding: 9px 12px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.75);
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 700;
    }

    .hero-gallery {
      position: relative;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 16px;
      align-items: start;
    }

    .hero-gallery img {
      height: 500px;
      border: 2px solid var(--charcoal);
      border-radius: 10px;
      box-shadow: var(--shadow);
    }

    .hero-gallery img:nth-child(2) {
      height: 430px;
      margin-top: 52px;
    }

    .hero-badge {
      position: absolute;
      left: 42%;
      bottom: 18px;
      z-index: 2;
      width: 170px;
      height: 170px;
      display: grid;
      place-items: center;
      border: 2px solid var(--charcoal);
      border-radius: 50%;
      background: var(--yellow);
      text-align: center;
      font-family: var(--display);
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.35;
      transform: rotate(-7deg);
      box-shadow: 5px 5px 0 var(--charcoal);
    }

    section {
      padding: 82px 0;
    }

    .section-heading {
      max-width: 680px;
      margin-bottom: 36px;
    }

    .section-heading.center {
      margin-inline: auto;
      text-align: center;
    }

    .section-heading h2 {
      margin-top: 10px;
      font-size: clamp(2.5rem, 5vw, 4rem);
      line-height: 1.02;
      letter-spacing: -0.045em;
    }

    .section-heading p {
      margin-top: 12px;
      color: var(--muted);
    }

    .menu-section {
      border-top: 2px solid var(--charcoal);
      border-bottom: 2px solid var(--charcoal);
      background: var(--scandi-beige);
    }

    .menu-slider {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(300px, 1fr);
      gap: 20px;
      overflow-x: auto;
      padding: 4px 3px 18px;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: thin;
      scrollbar-color: var(--charcoal) transparent;
      overscroll-behavior-inline: contain;
    }

    .menu-slider::-webkit-scrollbar {
      height: 8px;
    }

    .menu-slider::-webkit-scrollbar-track {
      background: transparent;
    }

    .menu-slider::-webkit-scrollbar-thumb {
      border-radius: 99px;
      background: var(--charcoal);
    }

    .menu-card {
      scroll-snap-align: start;
      overflow: hidden;
      border: 2px solid var(--charcoal);
      border-radius: 12px;
      background: var(--white);
      transition: 0.28s ease;
    }

    .menu-card:hover {
      transform: translateY(-6px);
      box-shadow: 7px 7px 0 var(--charcoal);
    }

    .menu-card img {
      height: 220px;
      border-bottom: 2px solid var(--charcoal);
      transition: transform 0.6s ease;
    }

    .menu-card:hover img {
      transform: scale(1.04);
    }

    .menu-card-body {
      padding: 22px;
    }

    .menu-card h3 {
      font-size: 1.4rem;
    }

    .menu-card p {
      min-height: 70px;
      margin-top: 10px;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .menu-meta {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    .menu-meta span {
      color: var(--muted);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .menu-meta strong {
      color: var(--sage-dark);
      font-size: 1rem;
    }

    .slider-controls {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 14px;
    }

    .slider-btn {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      border: 2px solid var(--charcoal);
      border-radius: 8px;
      background: white;
      transition: 0.25s ease;
    }

    .slider-btn:hover {
      background: var(--charcoal);
      color: white;
      transform: translateY(-2px);
    }

    .promo-strip {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 22px;
      align-items: center;
      margin-top: 28px;
      padding: 28px;
      border: 2px solid var(--charcoal);
      border-radius: 12px;
      background:
        linear-gradient(90deg, rgba(30,34,32,.93), rgba(59,70,64,.9)),
        url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1400&q=85") center/cover;
      color: white;
      box-shadow: 6px 6px 0 var(--charcoal);
    }

    .promo-strip h3 {
      font-size: 2rem;
    }

    .promo-strip p {
      margin-top: 6px;
      color: rgba(255, 255, 255, 0.7);
    }

    .promo-price {
      text-align: right;
    }

    .promo-price strong {
      display: block;
      font-size: 2.1rem;
      font-family: var(--display);
    }

    .promo-price span {
      color: rgba(255,255,255,.68);
      font-size: .7rem;
    }

    .about-layout {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 38px;
      align-items: center;
    }

    .about-copy p {
      margin-top: 18px;
      color: var(--muted);
      line-height: 1.8;
    }

    .about-gallery {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      grid-template-rows: 235px 235px;
      gap: 12px;
    }

    .about-gallery img {
      height: 100%;
      border: 2px solid var(--charcoal);
      border-radius: 10px;
      box-shadow: var(--shadow);
    }

    .about-gallery img:first-child {
      grid-row: 1 / 3;
    }

    .feature-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 42px;
    }

    .feature {
      padding: 24px;
      border: 2px solid var(--charcoal);
      border-radius: 12px;
      background: white;
      transition: 0.25s ease;
    }

    .feature:hover {
      transform: translateY(-5px);
      box-shadow: 6px 6px 0 var(--charcoal);
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border: 2px solid var(--charcoal);
      border-radius: 8px;
      background: var(--yellow);
      font-size: 1.15rem;
    }

    .feature h3 {
      margin-top: 16px;
      font-size: 1.3rem;
    }

    .feature p {
      margin-top: 8px;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .reviews {
      border-top: 2px solid var(--charcoal);
      border-bottom: 2px solid var(--charcoal);
      background: #f1eee8;
    }

    .review-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 30px;
    }

    .review {
      padding: 28px;
      border: 2px solid var(--charcoal);
      border-radius: 12px;
      background: white;
    }

    .review-stars {
      color: var(--sage);
      letter-spacing: 0.12em;
    }

    .review blockquote {
      margin: 18px 0;
      font-family: var(--display);
      font-size: 1.4rem;
      line-height: 1.45;
    }

    .review footer {
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .booking-layout {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 24px;
      align-items: stretch;
    }

    .visit-card {
      padding: 36px;
      border: 2px solid var(--charcoal);
      border-radius: 14px;
      background: var(--charcoal);
      color: white;
      box-shadow: 7px 7px 0 var(--scandi-beige);
    }

    .visit-card .eyebrow {
      color: var(--yellow);
    }

    .visit-card .eyebrow::before {
      background: var(--yellow);
    }

    .visit-card h2 {
      margin-top: 14px;
      font-size: clamp(2.4rem, 4vw, 3.5rem);
      line-height: 1.04;
    }

    .visit-card p {
      margin-top: 14px;
      color: rgba(255,255,255,.68);
    }

    .visit-details {
      display: grid;
      gap: 12px;
      margin-top: 26px;
      color: rgba(255,255,255,.88);
      font-size: 0.84rem;
    }

    .social-row {
      display: flex;
      gap: 9px;
      margin-top: 26px;
    }

    .social-row a {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 8px;
      transition: 0.25s ease;
    }

    .social-row a:hover {
      background: white;
      color: var(--charcoal);
    }

    .booking-box {
      padding: 40px;
      border: 2px solid var(--charcoal);
      border-radius: 14px;
      background: white;
      box-shadow: var(--shadow);
    }

    .booking-box h2 {
      text-align: center;
      font-size: 2.4rem;
    }

    .booking-box > p {
      max-width: 560px;
      margin: 10px auto 32px;
      color: var(--muted);
      text-align: center;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      display: grid;
      gap: 8px;
    }

    .form-group.full {
      grid-column: span 2;
    }

    .form-group label {
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .input-style {
      width: 100%;
      min-height: 50px;
      padding: 14px;
      border: 2px solid var(--charcoal);
      border-radius: 7px;
      background: white;
      color: var(--charcoal);
      outline: none;
    }

    .input-style:focus {
      border-color: var(--sage);
      box-shadow: 0 0 0 3px rgba(97,112,103,.12);
    }

    .whatsapp-btn {
      width: 100%;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 18px;
      border: 2px solid var(--charcoal);
      border-radius: 7px;
      background: var(--wa-green);
      color: white;
      font-weight: 800;
      box-shadow: 5px 5px 0 var(--charcoal);
      transition: 0.25s ease;
    }

    .whatsapp-btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0 var(--charcoal);
    }

    footer {
      padding: 36px 0;
      background: var(--charcoal);
      color: white;
    }

    .footer-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      color: rgba(255,255,255,.68);
      font-size: 0.75rem;
    }

    .footer-links {
      display: flex;
      gap: 16px;
      color: white;
      font-weight: 700;
    }

    .floating-wa {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 70;
      width: 56px;
      height: 56px;
      display: grid;
      place-items: center;
      border: 2px solid var(--charcoal);
      border-radius: 12px;
      background: var(--wa-green);
      color: white;
      box-shadow: 5px 5px 0 var(--charcoal);
      transition: 0.25s ease;
    }

    .floating-wa:hover {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0 var(--charcoal);
    }

    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: none;
    }

    @media (max-width: 900px) {
      .nav-links,
      .social-icons {
        display: none;
      }

      .menu-toggle {
        display: grid;
        place-items: center;
      }

      .hero-layout,
      .about-layout,
      .booking-layout {
        grid-template-columns: 1fr;
      }

      .hero-gallery {
        max-width: 700px;
      }

      .feature-row {
        grid-template-columns: 1fr;
      }

      .review-grid {
        grid-template-columns: 1fr;
      }

